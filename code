}

function sendNewCallsToTranscriptionN8nWithLimit_(maxToSend) {
  // Один запуск отправки одновременно: ручной из меню и автоотправка по
  // триггеру берут общий лок. Иначе два параллельных запуска отобрали бы
  // одни и те же строки-кандидаты и отправили их в n8n дважды.
  //
  // Лок именно documentLock, а НЕ scriptLock: scriptLock держат скан,
  // обновление сотрудников и пересчёт операторов, а порция из 50 записей
  // идёт минуты — на общем локе скан начал бы стабильно падать в SCAN_LOCKED.
  const lock = LockService.getDocumentLock();

  // Ждать нечего: соседний запуск шлёт свою порцию минутами, а следующая
  // порция и так придёт по триггеру — пропускаем запуск сразу.
  if (!lock.tryLock(0)) {
    flushLog_([[
      nowString_(),
      'send-' + Date.now(),
      'SEND_SKIPPED_LOCKED',
      '',
      'Отправка пропущена: предыдущий запуск ещё выполняется.'
    ]]);
    showToast_('Отправка уже идёт — запуск пропущен.');
    return;
  }

  try {
    sendNewCallsToTranscriptionN8nLocked_(maxToSend);
  } finally {
    lock.releaseLock();
  }
}

function sendNewCallsToTranscriptionN8nLocked_(maxToSend) {
  const sendLimit = normalizeSendLimit_(maxToSend);
  const limitText = sendLimit === null ? '∞ (все подходящие записи)' : String(sendLimit);
  const runId = 'send-' + Date.now();
  const runStartedAt = Date.now();

  // Пишем лог сразу, построчно: если скрипт зависнет или будет
  // убит по таймауту, уже записанные шаги останутся на листе «Лог».
  const logSheet = getOrCreateLogSheet_();

  const push = function(step, file, details) {
    const stepName = String(step || '');

    try {
      logSheet.appendRow([
        nowString_(),
        runId,
        stepName,
        String(file || '').slice(0, 300),
        String(details || '').slice(0, 2000)
      ]);

      // flush() дорогой: делаем его только на ключевых шагах, чтобы
      // строка гарантированно осталась на листе, если запуск оборвётся.
      if (FLUSH_LOG_STEPS.indexOf(stepName) !== -1) {
        SpreadsheetApp.flush();
      }
    } catch (e) {
      Logger.log('Не удалось записать лог: ' + e);
    }
  };

  try {
    push(
      'START',
      '',
      'Запуск отправки в n8n. URL: ' + String(CONFIG.N8N_WEBHOOK_URL) +
        ', лимит запуска: ' + limitText +
        ', лист: ' + CONFIG.SHEET_NAME +
        ', заголовок ' + CONFIG.N8N_SECRET_HEADER + ': ' + maskSecret_(CONFIG.N8N_SECRET)
    );

    getWebhookUrl_();

    // Промпты читаются и валидируются ДО отправки: при пустом или
    // неверно заполненном листе «Промпты» в n8n не уходит ни одного запроса.
    let prompts;

    try {
      prompts = loadPrompts_();
    } catch (e) {
      const promptsError = String((e && e.message) || e);

      push('PROMPTS_ERROR', '', promptsError);
      push('FINISH', '', 'Отправка отменена: ' + promptsError);
      showToast_('Отправка отменена: проверьте лист «' + CONFIG.PROMPTS_SHEET_NAME + '».');
      showAlert_('Отправка в n8n', promptsError);
      return;
    }

    push(
      'PROMPTS',
      '',
      'Промпты загружены с листа «' + CONFIG.PROMPTS_SHEET_NAME + '»: версия «' +
        (prompts.prompt_version || '(не задана)') + '», правил: ' + prompts.evaluation_rules.length +
        ', analysis_system_prompt: ' + (prompts.analysis_system_prompt ? 'задан' : 'по умолчанию из n8n')
    );

    // Снимок справочника сотрудников для n8n: он матчит requested_specialist
    // сам, поэтому получает employees в теле каждого запроса. Лист читается
    // один раз за ран (кэш в EMPLOYEES_CACHE_), пустой справочник отправку
    // не блокирует — предупреждение уже ушло в «Лог».
    const employees = loadEmployeesFromSheet_(push);

    push(
      'EMPLOYEES',
      '',
      'Справочник сотрудников: ' + employees.length + ' записей, активных: ' +
        employees.filter(function(employee) { return employee.active; }).length
    );

    const sheet = getOrCreateSheet_();
    ensureHeaders_(sheet);

    const headerMap = getHeaderMap_(sheet);
    const lastRow = sheet.getLastRow();

    if (lastRow < 2) {
      const emptyMessage = 'НЕТ СТРОК ДЛЯ ОТПРАВКИ. На листе «' + CONFIG.SHEET_NAME +
        '» нет ни одной строки с данными. Запустите «Обновить список записей».';

      push('NO_CANDIDATES', '', emptyMessage);
      push('FINISH', '', emptyMessage + ' Время: ' + (Date.now() - runStartedAt) + ' мс.');
      showToast_('Нет строк для отправки.');
      showAlert_('Отправка в n8n', emptyMessage);
      return;
    }

    const values = sheet
      .getRange(2, 1, lastRow - 1, sheet.getLastColumn())
      .getValues();

    // ФАЗА 1 — отбор кандидатов в памяти, без записи в лог.
    // Причины пропуска только считаются: построчный ROW_SKIP при сотнях
    // уже отправленных строк засорял «Лог» и растягивал запуск на минуты.
    const selection = collectSendCandidates_(values, headerMap, sendLimit);

    // ФАЗА 1.5 — проверка размера файла: она первая среди проверок отправки
    // и покрывает строки, просканированные до появления порога. Один
    // getSize на кандидата: кандидатов не больше лимита запуска.
    skipShortRecordingCandidates_(sheet, headerMap, selection, push);

    const skipSummary = describeSkipCounters_(selection);

    if (selection.candidates.length === 0) {
      const noCandidatesMessage = 'НЕТ СТРОК ДЛЯ ОТПРАВКИ. Просмотрено строк: ' +
        selection.scannedRows + ' (лимит запуска: ' + limitText + '); пропущено: ' + skipSummary +
        '. Запрос в n8n не отправлялся — отправлять нечего.';

      push('NO_CANDIDATES', '', noCandidatesMessage);
      push('FINISH', '', noCandidatesMessage + ' Время: ' + (Date.now() - runStartedAt) + ' мс.');
      showToast_('Нет строк для отправки.');
      showAlert_('Отправка в n8n', noCandidatesMessage);
      return;
    }

    push(
      'CANDIDATES',
      '',
      'CANDIDATES: найдено ' + selection.candidates.length +
        ' (лимит ' + limitText + ') из ' + selection.scannedRows + ' строк' +
        (selection.scannedRows < selection.totalRows
          ? ' (всего на листе ' + selection.totalRows + ', отбор прерван по лимиту)'
          : '') +
        '; пропущено: ' + skipSummary
    );

    // ФАЗА 2 — отправка: цикл только по отобранным кандидатам.
    let sent = 0;
    let errors = 0;
    let aborted = false;

    for (let i = 0; i < selection.candidates.length; i++) {
      const candidate = selection.candidates[i];
      const rowNumber = candidate.rowNumber;
      const row = candidate.row;
      const callKey = getCellByHeader_(row, headerMap, 'call_key');

      // Повтор после ошибки n8n (например «timeout exceeded»): строка снова
      // стала кандидатом, потому что результата у неё нет. Поля прошлой
      // попытки чистим ДО отправки — иначе строка выглядит одновременно
      // и отправленной, и завершившейся ошибкой.
      if (candidate.isRetry) {
        const previousError = getCellByHeader_(row, headerMap, 'transcription_error');

        push(
          'ROW_RETRY',
          callKey,
          'Строка ' + rowNumber + ': повтор после ошибки: ' + previousError.slice(0, 200) +
            '. Очищены transcription_error и transcription_received_at.'
        );

        setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_error', '');
        setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_received_at', '');
      }

      try {
        push('ROW_SEND', callKey, 'Строка ' + rowNumber + ': отправка...');
        const info = sendTranscriptionRow_(sheet, rowNumber, row, headerMap, push);
        sent++;
        push('ROW_OK', callKey, 'Строка ' + rowNumber + ': n8n принял. Ответ: ' + info);
      } catch (error) {
        errors++;
        const errorMessage = String(error.message || error);
        push('ROW_ERROR', callKey, 'Строка ' + rowNumber + ': ' + errorMessage);
        setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_send_status', 'ERROR');
        setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_error', errorMessage);
        setCellByHeader_(sheet, rowNumber, headerMap, 'updated_at', nowString_());

        // Сетевая ошибка одинакова для всех строк — прерываем запуск,
        // чтобы не ждать таймаут по каждой строке.
        if (errorMessage.indexOf('СЕТЬ:') === 0) {
          aborted = true;
          push('ABORT', '', 'Остановка: n8n недоступен. Проверьте адрес, доступность сервера и что workflow активирован.');
          break;
        }
      }
    }

    const durationMs = Date.now() - runStartedAt;

    const message =
      'Отправлено: ' + sent +
      ', ошибок: ' + errors +
      ', пропущено: ' + selection.skippedTotal +
      ', время: ' + durationMs + ' мс' +
      ', лимит: ' + limitText +
      (aborted ? ' (прервано: n8n недоступен)' : '');

    push('FINISH', '', message);
    showToast_(message);
    showAlert_('Отправка в n8n', message);

  } catch (e) {
    push('FATAL', '', String((e && e.stack) || e));
    throw e;
  }
}

/************************************************************
 * АВТООТПРАВКА В N8N (ТРИГГЕР)
 ************************************************************/

const AUTO_SEND_TRIGGER_HANDLER = 'autoSendCallsToTranscriptionN8n';
const AUTO_SEND_LAST_RUN_PROP = 'AUTO_SEND_LAST_RUN_AT';

/**
 * Обработчик минутного триггера. Реальная отправка — не чаще
 * CONFIG.AUTO_SEND_INTERVAL_MINUTES и не больше CONFIG.AUTO_SEND_BATCH_SIZE
 * записей за раз: n8n получает ровную нагрузку вместо лавины запросов.
 * Пустая очередь ничего не стоит: отбор кандидатов завершается за секунды.
 */
function autoSendCallsToTranscriptionN8n() {
  const props = PropertiesService.getScriptProperties();
  const intervalMs = autoSendIntervalMinutes_() * 60 * 1000;
  const lastRunAt = Number(props.getProperty(AUTO_SEND_LAST_RUN_PROP) || 0);
  const now = Date.now();

  if (now - lastRunAt < intervalMs) {
    return; // пауза ещё не прошла — в «Лог» не пишем, чтобы не засорять его каждую минуту
  }

  // Метка ставится ДО отправки: даже если запуск упадёт или затянется,
  // следующий начнётся не раньше чем через интервал от старта этого.
  props.setProperty(AUTO_SEND_LAST_RUN_PROP, String(now));

  sendNewCallsToTranscriptionN8nWithLimit_(CONFIG.AUTO_SEND_BATCH_SIZE);
}

/**
 * Включает автоотправку. Старые триггеры удаляются — повторный запуск их не плодит.
 */
function createAutoSendTrigger() {
  const removed = deleteAutoSendTriggers_();

  ScriptApp.newTrigger(AUTO_SEND_TRIGGER_HANDLER)
    .timeBased()
    .everyMinutes(1)
    .create();

  // Первая порция уходит на ближайшем срабатывании, а не через интервал.
  PropertiesService.getScriptProperties().deleteProperty(AUTO_SEND_LAST_RUN_PROP);

  const message = 'Автоотправка включена: до ' + CONFIG.AUTO_SEND_BATCH_SIZE +
    ' записей каждые ' + autoSendIntervalMinutes_() +
    ' мин. Удалено старых триггеров: ' + removed;

  flushLog_([[nowString_(), 'autosend-trigger-' + Date.now(), 'AUTOSEND_TRIGGER_CREATED', '', message]]);
  showToast_(message);
  showAlert_('Автоотправка в n8n', message);
}

/**
 * Выключает автоотправку (пункт меню).
 */
function deleteAutoSendTrigger() {
  const removed = deleteAutoSendTriggers_();
  const message = removed > 0
    ? 'Автоотправка выключена. Удалено триггеров: ' + removed
    : 'Автоотправка и так была выключена.';

  flushLog_([[nowString_(), 'autosend-trigger-' + Date.now(), 'AUTOSEND_TRIGGER_DELETED', '', message]]);
  showToast_(message);
  showAlert_('Автоотправка в n8n', message);
}

/**
 * Удаляет все триггеры автоотправки. Возвращает их количество.
 */
function deleteAutoSendTriggers_() {
  const triggers = ScriptApp.getProjectTriggers();
  let removed = 0;

  triggers.forEach(function(trigger) {
    if (trigger.getHandlerFunction() === AUTO_SEND_TRIGGER_HANDLER) {
      ScriptApp.deleteTrigger(trigger);
      removed++;
    }
  });

  return removed;
}

/**
 * Интервал автоотправки в минутах: не меньше 1, даже если CONFIG испорчен.
 */
function autoSendIntervalMinutes_() {
  const minutes = Number(CONFIG.AUTO_SEND_INTERVAL_MINUTES);

  return Number.isFinite(minutes) && minutes >= 1 ? Math.floor(minutes) : 6;
}

function normalizeSendLimit_(limit) {
  if (limit === null || limit === undefined || limit === '') {
    return null;
  }

  const n = Number(limit);

  if (!Number.isFinite(n) || n <= 0) {
    return null;
  }

  return Math.floor(n);
}
function sendTranscriptionRow_(sheet, rowNumber, row, headerMap, push) {
  const webhookUrl = getWebhookUrl_();

  // Логгер необязателен: функция работает и без диагностики.
  const log = typeof push === 'function' ? push : function() {};

  const direction = getCellByHeader_(row, headerMap, 'direction');
  const initiator =
    direction === 'INBOUND'
      ? 'Клиент'
      : direction === 'OUTBOUND'
        ? 'Оператор'
        : '';

  // Буквы колонок результата — n8n пишет точно в эти ячейки.
  const resultColumns = {};

  RESULT_HEADERS.forEach(function(header) {
    const column = headerMap[header];

    if (!column) {
      throw new Error('Нет колонки "' + header + '". Запустите «Обновить список записей».');
    }

    resultColumns[header] = columnToLetter_(column);
  });

  // Промпты уже провалидированы (loadPrompts_ вызывается до цикла отправки)
  // и закэшированы, поэтому лист «Промпты» читается один раз за запуск.
  const prompts = loadPrompts_();

  // Снимок справочника для матчинга специалистов в n8n.
  // Лист уже прочитан в начале отправки — здесь отдаётся кэш рана.
  const employees = buildEmployeesPayload_(loadEmployeesFromSheet_(log));

  const payload = {
    action: 'transcribe_and_analyze_call',

    // ID берётся из самой таблицы — руками нигде не указывается.
    spreadsheet_id: SpreadsheetApp.getActive().getId(),
    sheet_name: CONFIG.SHEET_NAME,
    row_number: rowNumber,
    result_columns: resultColumns,

    call_key: getCellByHeader_(row, headerMap, 'call_key'),
    filename_raw: getCellByHeader_(row, headerMap, 'filename_raw'),
    filename_fixed: getCellByHeader_(row, headerMap, 'filename_fixed'),

    call_datetime: getCellByHeader_(row, headerMap, 'call_datetime'),
    call_date: getCellByHeader_(row, headerMap, 'call_date'),
    call_time: getCellByHeader_(row, headerMap, 'call_time'),

    direction: direction,
    initiator: initiator,
    client_phone: getCellByHeader_(row, headerMap, 'client_phone'),
    mango_side: getCellByHeader_(row, headerMap, 'mango_side'),
    line_name: getCellByHeader_(row, headerMap, 'line_name'),
    // Оператор уже итоговый: матчинг выполнил скан, n8n его не пересчитывает.
    operator_name: getCellByHeader_(row, headerMap, 'operator_name'),

    drive_file_id: getCellByHeader_(row, headerMap, 'drive_file_id'),
    drive_url: getCellByHeader_(row, headerMap, 'drive_url'),

    // ПЕРЕХОДНОЕ ПОЛЕ, УДАЛИТЬ ЧЕРЕЗ НЕДЕЛЮ ПОСЛЕ ДЕПЛОЯ.
    // Справочник теперь живёт в staticData workflow (пуш раз в сутки на
    // /webhook/employees-directory), и нода Prepare Sheet Update читает
    // его оттуда. Здесь снимок остаётся только как fallback на время,
    // пока staticData ещё не заполнен. Вместе с этим полем убирается
    // fallback `meta.employees` в ноде Prepare Sheet Update — иначе
    // трафик payload (десятки МБ в день) никуда не денется.
    // AI список НЕ получает: сопоставление идёт кодом по снимку.
    employees: employees,

    // Результат n8n пишет в таблицу сам, поэтому callback не передаётся.
    prompts: prompts
  };

  const missing =
    !payload.call_key ? 'В строке нет call_key'
      : !payload.drive_file_id ? 'В строке нет drive_file_id'
        : !payload.direction ? 'Не определено направление звонка'
          : '';

  if (missing) {
    log('ERROR', payload.call_key, 'Строка ' + rowNumber + ': запрос не отправлен. ' + missing);
    throw new Error(missing);
  }

  const body = JSON.stringify(payload);

  const options = {
    method: 'post',
    contentType: 'application/json',
    payload: body,
    muteHttpExceptions: true,
    headers: {}
  };

  options.headers[CONFIG.N8N_SECRET_HEADER] = CONFIG.N8N_SECRET;

  // Сам payload в лог не пишем: в нём телефоны. Достаточно call_key и размера.
  log(
    'REQUEST',
    payload.call_key,
    'Строка ' + rowNumber + ': POST ' + webhookUrl +
      ', payload: ' + payloadSizeBytes_(body) + ' байт' +
      ', заголовок ' + CONFIG.N8N_SECRET_HEADER + ': ' + maskSecret_(CONFIG.N8N_SECRET)
  );

  const startedAt = Date.now();

  let response;

  try {
    response = UrlFetchApp.fetch(webhookUrl, options);
  } catch (e) {
    // Сюда попадают DNS/connect/timeout — сервер вообще не ответил.
    log(
      'ERROR',
      payload.call_key,
      'Строка ' + rowNumber + ': СЕТЬ: сервер не ответил за ' + (Date.now() - startedAt) +
        ' мс (DNS / timeout / connect). Текст ошибки: ' + String((e && e.stack) || e)
    );

    throw new Error('СЕТЬ: ' + String(e.message || e));
  }

  const durationMs = Date.now() - startedAt;
  const statusCode = response.getResponseCode();
  const responseText = response.getContentText();
  const hint = httpStatusHint_(statusCode, webhookUrl);

  log(
    'RESPONSE',
    payload.call_key,
    'Строка ' + rowNumber + ': HTTP ' + statusCode + ', ' + durationMs + ' мс' +
      ', ответ: ' + shortResponseText_(responseText) +
      (hint ? '. ' + hint : '')
  );

  if (statusCode < 200 || statusCode >= 300) {
    throw new Error('n8n вернул HTTP ' + statusCode + ': ' + responseText);
  }

  const now = nowString_();

  setCellByHeader_(sheet, rowNumber, headerMap, 'call_initiator', initiator);
  setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_send_status', 'SENT');
  setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_sent_at', now);
  setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_error', '');
  setCellByHeader_(sheet, rowNumber, headerMap, 'updated_at', now);

  return 'HTTP ' + statusCode + ' ' + String(responseText || '').slice(0, 300);
}

function getWebhookUrl_() {
  const url = String(CONFIG.N8N_WEBHOOK_URL || '').trim();

  if (!url || url.indexOf('ВАШ-N8N-ХОСТ') !== -1) {
    throw new Error(
      'В CONFIG.N8N_WEBHOOK_URL не указан адрес вашего n8n. ' +
      'Замените "ВАШ-N8N-ХОСТ" на реальный хост.'
    );
  }

  return url;
}

/************************************************************
 * ДИАГНОСТИКА ОТПРАВКИ В N8N
 *
 * Задача блока — по листу «Лог» однозначно различать четыре
 * сценария «в n8n нет executions»:
 *   1) нет строк-кандидатов — запрос вообще не отправлялся;
 *   2) сеть недоступна — UrlFetchApp бросил исключение;
 *   3) n8n ответил не-2xx (404 / 401 / 403 / 5xx);
 *   4) n8n ответил 2xx — запрос дошёл, смотреть надо в самом n8n.
 ************************************************************/

/**
 * Маска секрета для лога и alert: первые 4 символа + «…» + длина.
 * Полное значение не выводится нигде и никогда.
 */
function maskSecret_(value) {
  const secret = (value === null || value === undefined) ? '' : String(value);

  if (!secret) {
    return 'N8N_SECRET НЕ НАЙДЕН В SCRIPT PROPERTIES';
  }

  return secret.slice(0, 4) + '… (' + secret.length + ')';
}

/**
 * Размер тела запроса в байтах (UTF-8), а не в символах:
 * кириллица в payload занимает по 2 байта.
 */
function payloadSizeBytes_(text) {
  const s = String(text || '');

  try {
    return Utilities.newBlob(s).getBytes().length;
  } catch (e) {
    return s.length;
  }
}

/**
 * Первые 500 символов тела ответа — этого хватает и для JSON n8n,
 * и для HTML-страницы ошибки прокси.
 */
function shortResponseText_(text) {
  const s = String(text === null || text === undefined ? '' : text);

  if (!s) return '(пустое тело ответа)';

  return s.length > 500 ? s.slice(0, 500) + '…' : s;
}

/**
 * Не-ASCII символы в пути URL. Частая причина 404: в адрес попала
 * кириллическая буква, визуально неотличимая от латинской («с» vs «c»).
 * Возвращает список вида «с» (позиция 12, U+0441) — пустой, если всё чисто.
 */
function findNonAsciiInUrlPath_(url) {
  const source = String(url || '');

  // Хост из проверки исключаем: в нём не-ASCII — это легальный IDN.
  const withoutScheme = source.replace(/^[a-z][a-z0-9+.\-]*:\/\//i, '');
  const slashAt = withoutScheme.indexOf('/');

  if (slashAt === -1) return [];

  const path = withoutScheme.slice(slashAt).split('?')[0].split('#')[0];
  const found = [];

  for (let i = 0; i < path.length; i++) {
    const code = path.charCodeAt(i);

    if (code > 127) {
      const hex = code.toString(16).toUpperCase();
      found.push('«' + path[i] + '» (позиция ' + (i + 1) + ', U+' + ('0000' + hex).slice(-4) + ')');
    }
  }

  return found;
}

/**
 * Подсказка по HTTP-статусу: известные причины «нет executions».
 */
function httpStatusHint_(statusCode, url) {
  const code = Number(statusCode);

  if (code === 404) {
    const nonAscii = findNonAsciiInUrlPath_(url);

    return 'ПОДСКАЗКА: вебхук не найден: workflow неактивен или URL не production ' +
           '(проверьте /webhook/ vs /webhook-test/)' +
           (nonAscii.length > 0
             ? '. ВНИМАНИЕ: в пути вебхука есть не-ASCII символы: ' + nonAscii.join(', ')
             : '');
  }

  if (code === 401 || code === 403) {
    return 'ПОДСКАЗКА: не совпадает секрет/имя заголовка с Header Auth credential в n8n';
  }

  if (code >= 200 && code < 300) {
    return 'ПОДСКАЗКА: запрос дошёл — если executions нет, проверьте фильтр executions в n8n (Production/Test)';
  }

  if (code >= 500) {
    return 'ПОДСКАЗКА: ошибка на стороне n8n — смотрите логи сервера n8n';
  }

  return '';
}

/**
 * Шаги, после которых лог сбрасывается на лист немедленно.
 * На остальных строках flush() пропускается: он дорогой, а при сотнях
 * строк лога именно он и растягивал запуск на минуты.
 */
const FLUSH_LOG_STEPS = [
  'START',
  'PROMPTS',
  'PROMPTS_ERROR',
  'CANDIDATES',
  'NO_CANDIDATES',
  'ROW_SEND',
  'ROW_ERROR',
  'ABORT',
  'FINISH',
  'FATAL'
];

/**
 * Код причины пропуска строки при отправке ('' — строка-кандидат).
 * Условия одни на отбор кандидатов и на саму отправку: разойтись они
 * не могут, потому что живут в одной функции.
 */
function getSendSkipCode_(row, headerMap) {
  const driveFileId = getCellByHeader_(row, headerMap, 'drive_file_id');
  const parseError = getCellByHeader_(row, headerMap, 'error_text');
  const sendStatus = getCellByHeader_(row, headerMap, 'transcription_send_status');
  const receivedAt = getCellByHeader_(row, headerMap, 'transcription_received_at');

  if (!driveFileId) return 'NO_DRIVE_FILE_ID';
  if (parseError) return 'ERROR_TEXT';

  // Сознательно пропущенные строки (SKIPPED_SHORT и любые будущие
  // SKIPPED_*) в n8n не уходят никогда.
  if (sendStatus.indexOf('SKIPPED') === 0) return 'SKIPPED';

  // Автоповтор: строка с ошибкой n8n и без транскрипта снова кандидат —
  // проверяется ДО SENT и HAS_RESULT, иначе `timeout exceeded` навсегда
  // выводил бы строку из отправки.
  if (isSendRetryRow_(row, headerMap)) return '';

  // Есть результат — не переотправляем, даже если transcription_error
  // почему-то непустой.
  if (getCellByHeader_(row, headerMap, 'transcript_text')) return 'HAS_RESULT';

  if (sendStatus === 'SENT') return 'SENT';
  if (receivedAt) return 'HAS_RESULT';

  // Строки со статусом ERROR НЕ пропускаются — повторяем отправку.
  return '';
}

/**
 * Строка-повтор: n8n вернул ошибку (или ошибку записала сама отправка),
 * а транскрипта так и нет. Ограничения числа попыток нет — вечно падающая
 * строка видна в «Логе» по повторяющейся ошибке.
 */
function isSendRetryRow_(row, headerMap) {
  const transcriptionError = getCellByHeader_(row, headerMap, 'transcription_error');
  const transcriptText = getCellByHeader_(row, headerMap, 'transcript_text');

  return !!transcriptionError && !transcriptText;
}

/**
 * Фаза отбора: один проход по значениям листа, без единой записи в лог.
 * Проход прерывается, как только набрано sendLimit кандидатов, — поэтому
 * «1 запись» на листе с уже отправленными строками отрабатывает за секунды.
 */
function collectSendCandidates_(values, headerMap, sendLimit) {
  const selection = {
    totalRows: values.length,
    scannedRows: 0,
    candidates: [],
    skippedTotal: 0,
    skipped: {
      SENT: 0,
      NO_DRIVE_FILE_ID: 0,
      ERROR_TEXT: 0,
      HAS_RESULT: 0,
      SKIPPED: 0,
      // Заполняется фазой 1.5: строки, помеченные SKIPPED_SHORT в этом запуске.
      SKIPPED_SHORT: 0
    }
  };

  for (let i = 0; i < values.length; i++) {
    const row = values[i];

    selection.scannedRows++;

    const skipCode = getSendSkipCode_(row, headerMap);

    if (skipCode) {
      selection.skippedTotal++;
      selection.skipped[skipCode]++;
      continue;
    }

    selection.candidates.push({
      rowNumber: i + 2,
      row: row,
      isRetry: isSendRetryRow_(row, headerMap)
    });

    if (sendLimit !== null && selection.candidates.length >= sendLimit) break;
  }

  return selection;
}

/**
 * Счётчики причин пропуска одной строкой для лога. RETRY — не причина
 * пропуска, а разбивка самих кандидатов: сколько из них повторы после
 * ошибки n8n.
 */
function describeSkipCounters_(selection) {
  const skipped = selection.skipped;

  const retry = selection.candidates.filter(function(candidate) {
    return candidate.isRetry;
  }).length;

  return 'SENT=' + skipped.SENT +
    ', нет drive_file_id=' + skipped.NO_DRIVE_FILE_ID +
    ', error_text=' + skipped.ERROR_TEXT +
    ', есть результат=' + skipped.HAS_RESULT +
    ', SKIPPED=' + skipped.SKIPPED +
    ', SKIPPED_SHORT=' + skipped.SKIPPED_SHORT +
    ', RETRY=' + retry;
}

/************************************************************
 * КОРОТКИЕ ЗАПИСИ (МЕНЬШЕ ПОРОГА)
 *
 * Файл меньше CONFIG.MIN_AUDIO_FILE_SIZE_BYTES — несостоявшийся разговор
 * (сброс, обрыв). Такие записи не идут ни в транскрибацию, ни в анализ:
 * строка помечается сразу — при скане (новые файлы) или перед отправкой
 * (строки, просканированные до появления порога).
 ************************************************************/

function isShortAudioSize_(sizeBytes) {
  // Только настоящее число: неизвестный размер ('' , null) — это не
  // «короткая запись», такую строку помечать нельзя.
  if (typeof sizeBytes !== 'number' || !Number.isFinite(sizeBytes)) return false;

  return sizeBytes < Number(CONFIG.MIN_AUDIO_FILE_SIZE_BYTES);
}

/**
 * Порог человекочитаемо — из CONFIG, не строкой в тексте.
 */
function shortRecordingThresholdText_() {
  const bytes = Number(CONFIG.MIN_AUDIO_FILE_SIZE_BYTES) || 0;

  return Math.round(bytes / 1024) + ' КБ';
}

function shortRecordingSummary_() {
  return 'Разговор не состоялся (файл меньше ' + shortRecordingThresholdText_() + ')';
}

function describeShortRecording_(sizeBytes) {
  return 'Короткая запись: ' + sizeBytes + ' байт < порога ' +
    CONFIG.MIN_AUDIO_FILE_SIZE_BYTES + ' байт (' + shortRecordingThresholdText_() +
    '). В n8n не отправляется, статус ' + SKIPPED_SHORT_STATUS + '.';
}

function markRowSkippedShort_(sheet, rowNumber, headerMap) {
  setCellByHeader_(sheet, rowNumber, headerMap, 'transcription_send_status', SKIPPED_SHORT_STATUS);
  setCellByHeader_(sheet, rowNumber, headerMap, 'summary', shortRecordingSummary_());
  setCellByHeader_(sheet, rowNumber, headerMap, 'updated_at', nowString_());
}

/**
 * Фаза 1.5 отправки: у каждого кандидата проверяется размер файла на Drive.
 * Меньше порога — строка помечается SKIPPED_SHORT и выбывает из отправки.
 *
 * Недоступный файл (удалён из Drive, нет прав) SKIPPED_SHORT НЕ получает:
 * такая строка идёт в отправку, и ошибка обрабатывается как раньше.
 *
 * selection изменяется на месте: candidates и счётчики.
 */
function skipShortRecordingCandidates_(sheet, headerMap, selection, push) {
  const log = typeof push === 'function' ? push : function() {};
  const kept = [];

  selection.candidates.forEach(function(candidate) {
    const row = candidate.row;
    const rowNumber = candidate.rowNumber;
    const callKey = getCellByHeader_(row, headerMap, 'call_key');
    const filename = getCellByHeader_(row, headerMap, 'filename_fixed') || callKey;
    const driveFileId = getCellByHeader_(row, headerMap, 'drive_file_id');

    let size;

    try {
      size = DriveApp.getFileById(driveFileId).getSize();
    } catch (e) {
      log(
        'ROW_SIZE_UNKNOWN',
        filename,
        'Строка ' + rowNumber + ': не удалось получить размер файла ' + driveFileId +
          ' — ' + String((e && e.message) || e) + '. Строка отправляется как обычно.'
      );

      kept.push(candidate);
      return;
    }

    if (!isShortAudioSize_(size)) {
      kept.push(candidate);
      return;
    }

    markRowSkippedShort_(sheet, rowNumber, headerMap);

    selection.skippedTotal++;
    selection.skipped.SKIPPED_SHORT++;

    log('ROW_SKIPPED_SHORT', filename, 'Строка ' + rowNumber + ': ' + describeShortRecording_(size));
  });

  selection.candidates = kept;

  return selection;
}

/**
 * Показ сообщения пользователю. Вне UI-контекста (триггер, запуск из
 * редактора) alert недоступен — тогда просто молчим, всё уже в логе.
 */
function showAlert_(title, message) {
  try {
    SpreadsheetApp.getUi().alert(title, message, SpreadsheetApp.getUi().ButtonSet.OK);
  } catch (e) {
    Logger.log(title + '\n' + message);
  }
}

/**
 * «Тест: пинг n8n» — POST без данных таблицы.
 * Проверяет ровно три вещи: доходит ли запрос до хоста, какой у него
 * итоговый URL и виден ли скрипту секрет из Script Properties.
 * Строки таблицы не читаются и не изменяются.
 */
function pingN8nWebhook() {
  const runId = 'ping-' + Date.now();
  const log = [];
  const report = [];

  const push = function(step, details) {
    const text = String(details || '');

    log.push([
      nowString_(),
      runId,
      String(step || ''),
      '',
      text.slice(0, 2000)
    ]);

    report.push(text);
  };

  try {
    const url = String(CONFIG.N8N_WEBHOOK_URL || '').trim();

    push('PING_START', 'Пинг n8n без данных таблицы.');
    push('PING_URL', 'URL: ' + (url || '(пусто — CONFIG.N8N_WEBHOOK_URL не задан)'));
    push(
      'PING_SECRET',
      'Заголовок: ' + CONFIG.N8N_SECRET_HEADER + ', значение: ' + maskSecret_(CONFIG.N8N_SECRET)
    );

    if (!url) {
      push('PING_FINISH', 'Пинг не выполнен: не задан CONFIG.N8N_WEBHOOK_URL.');
      showAlert_('Тест: пинг n8n', report.join('\n\n'));
      return;
    }

    const body = JSON.stringify({
      action: 'ping',
      ts: new Date().toISOString()
    });

    const options = {
      method: 'post',
      contentType: 'application/json',
      payload: body,
      muteHttpExceptions: true,
      headers: {}
    };

    options.headers[CONFIG.N8N_SECRET_HEADER] = String(CONFIG.N8N_SECRET || '');

    push('PING_REQUEST', 'POST, тело: ' + body + ', размер: ' + payloadSizeBytes_(body) + ' байт.');

    const startedAt = Date.now();

    let response;

    try {
      response = UrlFetchApp.fetch(url, options);
    } catch (e) {
      const failedAfter = Date.now() - startedAt;

      push(
        'PING_ERROR',
        'СЕТЬ: сервер не ответил за ' + failedAfter + ' мс (DNS / timeout / connect). ' +
        'Текст ошибки: ' + String((e && e.message) || e)
      );

      showAlert_('Тест: пинг n8n', report.join('\n\n'));
      return;
    }

    const durationMs = Date.now() - startedAt;
    const statusCode = response.getResponseCode();
    const hint = httpStatusHint_(statusCode, url);

    push(
      'PING_RESPONSE',
      'HTTP ' + statusCode + ', ' + durationMs + ' мс. Ответ: ' + shortResponseText_(response.getContentText())
    );

    if (hint) push('PING_HINT', hint);

    push('PING_FINISH', 'Пинг завершён.');

    showAlert_('Тест: пинг n8n', report.join('\n\n'));

  } catch (e) {
    push('PING_FATAL', String((e && e.stack) || e));
    showAlert_('Тест: пинг n8n', report.join('\n\n'));
    throw e;
  } finally {
    flushLog_(log);
  }
}

/************************************************************
 * ЛОГ (ЛИСТ «Лог»)
 ************************************************************/

function getOrCreateLogSheet_() {
  const ss = SpreadsheetApp.getActive();
  let sheet = ss.getSheetByName(CONFIG.LOG_SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.LOG_SHEET_NAME);
  }

  ensureSheetHeaders_(sheet, LOG_HEADERS);
  return sheet;
}

function flushLog_(rows) {
  if (!rows || rows.length === 0) return;

  try {
    const sheet = getOrCreateLogSheet_();

    if (sheet.getLastRow() > CONFIG.MAX_LOG_ROWS) {
      sheet
        .getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn())
        .clearContent();
    }

    sheet
      .getRange(sheet.getLastRow() + 1, 1, rows.length, LOG_HEADERS.length)
      .setValues(rows);
  } catch (e) {
    Logger.log('Не удалось записать лог: ' + e);
  }
}

/************************************************************
 * ПРОМПТЫ (ЛИСТ «Промпты»)
 *
 * loadPrompts_() возвращает объект, который целиком уходит в payload
 * в поле prompts:
 *   {
 *     prompt_version: 'v2',
 *     transcription_prompt: '...',
 *     analysis_system_prompt: '...',   // ключа нет, если поле пустое
 *     evaluation_rules: [
 *       { rule_id, title, description, weight, na_allowed }
 *     ]
 *   }
 *
 * Любая проблема с листом — исключение с понятным текстом. Оно ловится
 * в отправке и попадает на лист «Лог» ДО того, как что-то уйдёт в n8n.
 ************************************************************/

function loadPrompts_() {
  if (PROMPTS_CACHE_) return PROMPTS_CACHE_;

  const sheet = SpreadsheetApp.getActive().getSheetByName(CONFIG.PROMPTS_SHEET_NAME);

  if (!sheet) {
    createDefaultPromptsSheet_();

    throw new Error(
      'Лист «' + CONFIG.PROMPTS_SHEET_NAME + '» не найден — он создан с примером содержимого. ' +
      'Заполните лист «' + CONFIG.PROMPTS_SHEET_NAME + '» (промпт транскрибации и правила оценки) ' +
      'и повторите отправку.'
    );
  }

  const parsed = parsePromptsSheet_(sheet);
  const problems = validatePrompts_(parsed);

  if (problems.length > 0) {
    throw new Error(
      'Лист «' + CONFIG.PROMPTS_SHEET_NAME + '» заполнен неверно: ' + problems.join('; ') + '.'
    );
  }

  const prompts = {
    prompt_version: parsed.params.prompt_version,
    transcription_prompt: parsed.params.transcription_prompt,
    evaluation_rules: parsed.rules
  };

  // Пустой analysis_system_prompt не передаём: нода n8n подставит дефолт.
  if (parsed.params.analysis_system_prompt) {
    prompts.analysis_system_prompt = parsed.params.analysis_system_prompt;
  }

  PROMPTS_CACHE_ = prompts;

  return prompts;
}

/**
 * Читает лист целиком и раскладывает на параметры и правила.
 * Ничего не валидирует — это делает validatePrompts_.
 */
function parsePromptsSheet_(sheet) {
  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();

  const result = {
    params: { prompt_version: '', transcription_prompt: '', analysis_system_prompt: '' },
    rules: [],
    rulesHeaderRow: 0,
    ruleRowNumbers: []
  };

  if (lastRow < 1 || lastColumn < 1) return result;

  const values = sheet.getRange(1, 1, lastRow, Math.max(lastColumn, PROMPT_RULE_HEADERS.length)).getValues();

  let rulesHeaderIndex = -1;

  for (let i = 0; i < values.length; i++) {
    if (String(values[i][0] || '').trim().toLowerCase() === 'rule_id') {
      rulesHeaderIndex = i;
      break;
    }
  }

  const paramsLastIndex = rulesHeaderIndex === -1 ? values.length : rulesHeaderIndex;

  for (let i = 0; i < paramsLastIndex; i++) {
    const key = String(values[i][0] || '').trim();

    if (PROMPT_PARAM_KEYS.indexOf(key) !== -1) {
      result.params[key] = String(values[i][1] === null || values[i][1] === undefined ? '' : values[i][1]).trim();
    }
  }

  if (rulesHeaderIndex === -1) return result;

  result.rulesHeaderRow = rulesHeaderIndex + 1;

  for (let i = rulesHeaderIndex + 1; i < values.length; i++) {
    const row = values[i];

    const ruleId = String(row[0] === null || row[0] === undefined ? '' : row[0]).trim();
    const title = String(row[1] === null || row[1] === undefined ? '' : row[1]).trim();
    const description = String(row[2] === null || row[2] === undefined ? '' : row[2]).trim();
    const weightRaw = row[3];
    const naRaw = row[4];

    // Полностью пустая строка — просто разделитель, не ошибка.
    if (!ruleId && !title && !description &&
        (weightRaw === '' || weightRaw === null || weightRaw === undefined) &&
        (naRaw === '' || naRaw === null || naRaw === undefined)) {
      continue;
    }

    result.rules.push({
      rule_id: ruleId,
      title: title,
      description: description,
      weight: parsePromptWeight_(weightRaw),
      na_allowed: parsePromptBoolean_(naRaw)
    });

    result.ruleRowNumbers.push(i + 1);
  }

  return result;
}

/**
 * Список проблем листа. Пустой массив — лист валиден.
 */
function validatePrompts_(parsed) {
  const problems = [];

  if (!parsed.params.transcription_prompt) {
    problems.push('не заполнен transcription_prompt');
  }

  if (!parsed.rulesHeaderRow) {
    problems.push('не найдена таблица правил (строка с «rule_id» в первой колонке)');
  }

  if (parsed.rules.length === 0) {
    problems.push('нет ни одного правила оценки (нужно минимум одно)');
    return problems;
  }

  const seen = {};

  parsed.rules.forEach(function(rule, index) {
    const rowNumber = parsed.ruleRowNumbers[index];
    const where = 'строка ' + rowNumber;

    if (!rule.rule_id) {
      problems.push(where + ': пустой rule_id');
    } else if (seen[rule.rule_id]) {
      problems.push(where + ': повторяющийся rule_id «' + rule.rule_id + '»');
    } else {
      seen[rule.rule_id] = true;
    }

    if (!rule.title) {
      problems.push(where + ': пустой title');
    }

    if (rule.weight === null) {
      problems.push(where + ': weight должен быть положительным числом');
    }

    if (rule.na_allowed === null) {
      problems.push(where + ': na_allowed должен быть TRUE или FALSE');
    }
  });

  return problems;
}

/**
 * Вес правила: положительное число. Всё остальное — null (ошибка).
 */
function parsePromptWeight_(value) {
  if (value === null || value === undefined || value === '') return null;

  const n = Number(String(value).replace(',', '.').trim());

  if (!isFinite(n) || n <= 0) return null;

  return n;
}

/**
 * na_allowed: чекбокс, TRUE/FALSE, ДА/НЕТ, 1/0. Всё остальное — null (ошибка).
 */
function parsePromptBoolean_(value) {
  if (value === true) return true;
  if (value === false) return false;

  const s = String(value === null || value === undefined ? '' : value).trim().toLowerCase();

  if (['true', 'да', 'yes', '1', 'истина'].indexOf(s) !== -1) return true;
  if (['false', 'нет', 'no', '0', 'ложь'].indexOf(s) !== -1) return false;

  return null;
}

/**
 * Создаёт лист «Промпты» с рабочим примером: версия, промпт
 * транскрибации и пять правил оценки. Существующий лист не трогает.
 */
function createDefaultPromptsSheet_() {
  const ss = SpreadsheetApp.getActive();

  if (ss.getSheetByName(CONFIG.PROMPTS_SHEET_NAME)) {
    return ss.getSheetByName(CONFIG.PROMPTS_SHEET_NAME);
  }

  const sheet = ss.insertSheet(CONFIG.PROMPTS_SHEET_NAME);

  const rows = [];

  rows.push(PROMPTS_SHEET_HEADER.concat(['', '']));

  DEFAULT_PROMPTS_PARAMS.forEach(function(param) {
    rows.push([param[0], param[1], param[2], '', '']);
  });

  rows.push(['', '', '', '', '']);
  rows.push(PROMPT_RULE_HEADERS.slice());

  DEFAULT_PROMPTS_RULES.forEach(function(rule) {
    rows.push(rule.slice());
  });

  sheet.getRange(1, 1, rows.length, PROMPT_RULE_HEADERS.length).setValues(rows);

  sheet.getRange(1, 1, 1, PROMPTS_SHEET_HEADER.length).setFontWeight('bold');
  sheet.getRange(DEFAULT_PROMPTS_PARAMS.length + 3, 1, 1, PROMPT_RULE_HEADERS.length).setFontWeight('bold');

  sheet.setColumnWidth(1, 200);
  sheet.setColumnWidth(2, 420);
  sheet.setColumnWidth(3, 420);

  return sheet;
}


/************************************************************
 * СПРАВОЧНИК СОТРУДНИКОВ (ЛИСТ «Сотрудники»)
 *
 * Единственный источник истины по сотрудникам — лист «Сотрудники»
 * в этой же таблице. Битрикс используется ТОЛЬКО для обновления листа
 * (пункт меню или ночной триггер); в момент матчинга в Битрикс не ходим.
 *
 * Кто чем пользуется:
 *   • ФИО оператора матчит скан (scanMangoRecordingsFolder) по этому листу,
 *     с учётом ручного маппинга на листе «Операторы»;
 *   • requested_specialist и appointment_specialist матчит n8n — снимок
 *     листа уезжает в payload как employees, потому что результат n8n
 *     пишет в таблицу напрямую.
 *
 * AI список сотрудников НЕ получает и ФИО не сопоставляет: свободная
 * генерация модели не источник истины для фамилий.
 ************************************************************/

const EMPLOYEES_HEADERS = [
  'bitrix_user_id',
  'active',
  'last_name',
  'name',
  'second_name',
  'full_name',
  'full_name_normalized',
  'short_name',
  'short_name_normalized',
  'last_name_normalized',
  'name_patronymic_normalized',
  'work_position',
  'department_ids',
  'updated_at'
];

// Защита от бесконечного цикла пагинации user.get.
const BITRIX_USER_PAGES_LIMIT = 40;

// Сколько ждём scriptLock. Lock один на скрипт: скан, обновление
// сотрудников (ручное и по ночному триггеру) и пересчёт операторов не
// должны писать листы одновременно.
const SHEET_LOCK_TIMEOUT_MS = 30000;

const EMPLOYEES_TRIGGER_HANDLER = 'refreshEmployeesFromBitrix';

// Кто попадает в справочник, уезжающий в n8n. Матчинг специалистов имеет
// смысл только для тех, к кому записывают на приём, поэтому из полного
// снимка листа берётся подмножество: активные сотрудники, в должности
// которых встречается одна из подстрок (регистр и «ё» не важны, позиция
// в строке любая — «Врач-невролог», «Инструктор ЛФК», «физиотерапевт»).
//
// ВНИМАНИЕ: фильтр сужает матчинг. Должности вне списка («массажист»,
// «невролог» без слова «врач») перестанут матчиться — перед правкой
// сверяйтесь с уникальными work_position на листе «Сотрудники».
// Тот же список продублирован в ноде n8n Receive Employees Directory:
// приёмник не доверяет присланному и фильтрует сам.
const EMPLOYEES_DIRECTORY_POSITION_PATTERNS = ['врач', 'лфк', 'терапевт', 'реабилитолог'];

// Сколько изменений перечислять в details события OPERATOR_RECALC_FINISH.
// Пособытийный лог на строку не пишем: на сотнях строк он раздувает «Лог».
const OPERATOR_RECALC_LOG_SAMPLE_LIMIT = 20;

// Соседние изменённые строки пишутся одним setValues. Разрыв до этого
// числа строк перекрывается тем же диапазоном (в промежутке пишутся их же
// прежние значения) — так на сотнях разбросанных изменений получается
// десятки вызовов записи вместо сотен.
const OPERATOR_RECALC_MAX_WRITE_GAP = 25;

// Заголовки листа «Операторы» (ручной маппинг). Колонку «Сотрудник» ведёт
// пользователь; ключи mango_side скрипт умеет дописывать пунктом меню
// «Обновить mango side» (updateMangoSideList).
const OPERATORS_KEY_HEADER = 'mango_side';
const OPERATORS_VALUE_HEADER = 'Сотрудник';

// Кэш на время одного выполнения скрипта: лист читается один раз.
let EMPLOYEES_CACHE_ = null;

// Кэш ручного маппинга операторов — тоже один раз за ран.
let OPERATOR_MAPPING_CACHE_ = null;

/************************************************************
 * ОБНОВЛЕНИЕ ЛИСТА ИЗ БИТРИКС24
 *
 * Свойство скрипта BITRIX_WEBHOOK_BASE_URL — базовый URL входящего
 * вебхука Битрикс24 вида:
 *   https://portal.bitrix24.ru/rest/USER_ID/TOKEN
 * Вызывается {BASE}/user.get.json БЕЗ фильтра по ACTIVE: на листе нужны
 * и активные, и уволенные (звонки в архиве старше увольнения).
 ************************************************************/

/**
 * Полностью перезаписывает лист «Сотрудники» снимком из Битрикс.
 * Работает и из меню, и из триггера: UI-вызовы обёрнуты в try/catch.
 */
function refreshEmployeesFromBitrix() {
  const runId = 'employees-' + Date.now();
  const log = [];

  const push = function(step, file, details) {
    log.push([
      nowString_(),
      runId,
      String(step || ''),
      String(file || '').slice(0, 300),
      String(details || '').slice(0, 2000)
    ]);
  };

  const lock = LockService.getScriptLock();

  if (!lock.tryLock(SHEET_LOCK_TIMEOUT_MS)) {
    push(
      'EMPLOYEES_REFRESH_LOCKED',
      '',
      'Обновление уже выполняется (lock не получен за ' +
        SHEET_LOCK_TIMEOUT_MS + ' мс). Запуск пропущен.'
    );

    flushLog_(log);
    showToast_('Обновление сотрудников уже выполняется — запуск пропущен.');
    return;
  }

  try {
    push('EMPLOYEES_REFRESH_START', '', 'Загрузка сотрудников из Битрикс (user.get, все статусы)');

    const users = fetchBitrixUsers_(push);
    const updatedAt = nowString_();

    const rows = [];
    const employees = [];
    let activeCount = 0;
    let skippedNoName = 0;

    users.forEach(function(user) {
      const employee = buildEmployeeFromBitrixUser_(user, updatedAt);

      // Пользователь без ФИО матчингу бесполезен и занимает пустую строку.
      if (!employee.full_name) {
        skippedNoName++;
        return;
      }

      if (employee.active) activeCount++;

      employees.push(employee);

      rows.push(EMPLOYEES_HEADERS.map(function(header) {
        return employee[header];
      }));
    });

    push('EMPLOYEES_REFRESH_WRITE', '', 'Запись снимка на лист «' + CONFIG.EMPLOYEES_SHEET_NAME + '»: ' + rows.length + ' строк');

    writeEmployeesSheet_(rows);

    // Снимок изменился — кэш рана больше не актуален.
    EMPLOYEES_CACHE_ = null;

    // Пуш справочника в staticData n8n. Инициатор — этот суточный триггер;
    // приёмник в n8n дополнительно отбивает всё, что чаще 23 часов.
    // Неуспех POST лист не откатывает: снимок уже записан и корректен,
    // n8n доедет следующим суткам или ручным пунктом меню.
    pushEmployeesDirectoryToN8n_(employees, false, push);

    const message = 'Обновлено сотрудников: ' + rows.length + ', активных: ' + activeCount +
      (skippedNoName ? ', пропущено без ФИО: ' + skippedNoName : '');

    push('EMPLOYEES_REFRESH_FINISH', '', message);
    showToast_('Сотрудники обновлены: ' + rows.length + ', активных: ' + activeCount);

  } catch (e) {
    push('EMPLOYEES_REFRESH_ERROR', '', String((e && e.stack) || e));
    showToast_('Ошибка обновления сотрудников: ' + String((e && e.message) || e));
    throw e;
  } finally {
    lock.releaseLock();
    flushLog_(log);
  }
}

/**
 * Все пользователи Битрикс постранично. Фильтра по ACTIVE нет намеренно:
 * уволенные тоже нужны, их активность видна в колонке active.
 */
function fetchBitrixUsers_(push) {
  const base = PropertiesService.getScriptProperties().getProperty('BITRIX_WEBHOOK_BASE_URL');

  if (!base) {
    throw new Error(
      'Не задано свойство скрипта BITRIX_WEBHOOK_BASE_URL.\n' +
      'Укажите базовый webhook Битрикс в Project Settings → Script properties.'
    );
  }

  const baseUrl = String(base).replace(/\/+$/, '');
  const users = [];
  let start = 0;

  for (let page = 0; page < BITRIX_USER_PAGES_LIMIT; page++) {
    const url = baseUrl + '/user.get.json?start=' + start;
    const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    const code = response.getResponseCode();

    if (code !== 200) {
      throw new Error(
        'Bitrix user.get вернул HTTP ' + code + ': ' +
        String(response.getContentText()).slice(0, 300)
      );
    }

    const data = JSON.parse(response.getContentText());

    if (data.error) {
      throw new Error('Bitrix user.get: ' + data.error + ' — ' + (data.error_description || ''));
    }

    const batch = data.result || [];

    batch.forEach(function(user) {
      users.push(user);
    });

    push(
      'EMPLOYEES_REFRESH_PAGE',
      '',
      'страница ' + (page + 1) + ', получено ' + batch.length + ', всего ' + users.length
    );

    if (data.next === undefined || data.next === null) break;

    start = data.next;
  }

  return users;
}

/**
 * Пользователь Битрикс → строка листа «Сотрудники».
 * Нормализованные формы считаются здесь и хранятся на листе: потребители
 * (скан и n8n) читают готовые значения и сами ничего не нормализуют.
 */
function buildEmployeeFromBitrixUser_(user, updatedAt) {
  const lastName = String((user && user.LAST_NAME) || '').trim();
  const firstName = String((user && user.NAME) || '').trim();
  const secondName = String((user && user.SECOND_NAME) || '').trim();

  const fullName = [lastName, firstName, secondName].filter(Boolean).join(' ');

  // «Фамилия И» или «Фамилия И О» — так оператора пишет Mango.
  const initials = [firstName, secondName]
    .filter(Boolean)
    .map(function(part) { return part.charAt(0); })
    .join(' ');

  const shortName = lastName && initials ? lastName + ' ' + initials : lastName;

  // «Имя Отчество» — так специалиста часто называют в разговоре.
  // Без имени формы нет: одно отчество никого не идентифицирует.
  const namePatronymic = firstName ? [firstName, secondName].filter(Boolean).join(' ') : '';

  const departments = user && user.UF_DEPARTMENT;

  return {
    bitrix_user_id: String((user && user.ID) || '').trim(),
    active: parseEmployeeBoolean_(user && user.ACTIVE) ? 'TRUE' : 'FALSE',
    last_name: lastName,
    name: firstName,
    second_name: secondName,
    full_name: fullName,
    full_name_normalized: normalizeFio_(fullName),
    short_name: shortName,
    short_name_normalized: normalizeFio_(shortName),
    last_name_normalized: normalizeFio_(lastName),
    name_patronymic_normalized: normalizeFio_(namePatronymic),
    work_position: String((user && user.WORK_POSITION) || '').trim(),
    department_ids: Array.isArray(departments)
      ? departments.join(',')
      : String(departments === null || departments === undefined ? '' : departments).trim(),
    updated_at: updatedAt
  };
}

/**
 * Полная перезапись листа: старые строки очищаются, снимок пишется
 * одним setValues. Дублей по bitrix_user_id нет по построению —
 * лист всегда содержит ровно один снимок.
 */
function writeEmployeesSheet_(rows) {
  const sheet = getOrCreateEmployeesSheet_();
  const lastRow = sheet.getLastRow();

  if (lastRow > 1) {
    sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).clearContent();
  }

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, EMPLOYEES_HEADERS.length).setValues(rows);
  }
}

/**
 * Лист-снимок целиком принадлежит скрипту, поэтому шапка пишется жёстко
 * в A1 (append-логика ensureSheetHeaders_ здесь не годится: мусор в A1
 * сдвинул бы все колонки). Лишние колонки справа очищаются.
 */
function getOrCreateEmployeesSheet_() {
  const ss = SpreadsheetApp.getActive();
  let sheet = ss.getSheetByName(CONFIG.EMPLOYEES_SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.EMPLOYEES_SHEET_NAME);
  }

  ensureSheetColumnCount_(sheet, EMPLOYEES_HEADERS.length);

  sheet.getRange(1, 1, 1, EMPLOYEES_HEADERS.length).setValues([EMPLOYEES_HEADERS]);

  const extraColumns = sheet.getMaxColumns() - EMPLOYEES_HEADERS.length;

  if (extraColumns > 0) {
    sheet.getRange(1, EMPLOYEES_HEADERS.length + 1, sheet.getMaxRows(), extraColumns).clearContent();
  }

  sheet.setFrozenRows(1);

  return sheet;
}

/************************************************************
 * ЕЖЕДНЕВНЫЙ ТРИГГЕР ОБНОВЛЕНИЯ
 ************************************************************/

/**
 * Пересоздаёт ежедневный триггер обновления сотрудников.
 * Старые триггеры удаляются, поэтому повторный запуск их не плодит.
 */
function createEmployeesDailyRefreshTrigger() {
  const removed = deleteEmployeesDailyRefreshTriggers_();

  ScriptApp.newTrigger(EMPLOYEES_TRIGGER_HANDLER)
    .timeBased()
    .everyDays(1)
    .atHour(0)
    .nearMinute(1)
    .create();

  flushLog_([[
    nowString_(),
    'employees-trigger-' + Date.now(),
    'EMPLOYEES_TRIGGER_CREATED',
    '',
    'Создан ежедневный триггер ' + EMPLOYEES_TRIGGER_HANDLER +
      ' (около 00:01). Удалено старых триггеров: ' + removed
  ]]);

  // «Около» — не оговорка: Apps Script запускает триггер в пределах часа.
  showToast_('Ежедневный триггер обновления сотрудников создан: около 00:01');
}

/**
 * Удаляет все триггеры обновления сотрудников. Возвращает их количество.
 */
function deleteEmployeesDailyRefreshTriggers_() {
  const triggers = ScriptApp.getProjectTriggers();
  let removed = 0;

  triggers.forEach(function(trigger) {
    if (trigger.getHandlerFunction() === EMPLOYEES_TRIGGER_HANDLER) {
      ScriptApp.deleteTrigger(trigger);
      removed++;
    }
  });

  return removed;
}

/************************************************************
 * СПРАВОЧНИК → STATICDATA N8N
 *
 * Раньше снимок листа «Сотрудники» ехал в payload КАЖДОГО звонка —
 * это десятки мегабайт UrlFetch-трафика в день на пустом месте.
 * Теперь справочник уходит в n8n раз в сутки (после обновления листа
 * из Битрикс) и живёт в staticData workflow транскрибации.
 *
 * Частота: инициирует один суточный триггер, приёмник в n8n дополнительно
 * отбивает всё, что чаще 23 часов. Ручное внеплановое обновление — пункт
 * меню «Отправить справочник в n8n сейчас» (force: true).
 ************************************************************/

/**
 * Пункт меню: внеплановый пуш справочника с обходом суточного гейта.
 * Нужен после переимпорта workflow в n8n — staticData при экспорте
 * и импорте не переносится, справочник приходится класть заново.
 */
function pushEmployeesDirectoryToN8nNow() {
  const runId = 'employees-push-' + Date.now();
  const log = [];

  const push = function(step, file, details) {
    log.push([
      nowString_(),
      runId,
      String(step || ''),
      String(file || '').slice(0, 300),
      String(details || '').slice(0, 2000)
    ]);
  };

  try {
    const employees = loadEmployeesFromSheet_(push);

    if (!employees.length) {
      showToast_('Лист «' + CONFIG.EMPLOYEES_SHEET_NAME + '» пуст: отправлять нечего.');
      return;
    }

    const result = pushEmployeesDirectoryToN8n_(employees, true, push);

    showToast_(
      result.ok
        ? 'Справочник отправлен в n8n: ' + result.sent + ' сотрудников. ' + result.response
        : 'Справочник в n8n не отправлен: ' + result.response
    );
  } finally {
    flushLog_(log);
  }
}

/**
 * Активные сотрудники, к которым записывают на приём. Остальные строки
 * листа матчингу специалистов не нужны и в n8n не уезжают.
 */
function filterEmployeesForDirectory_(employees) {
  return (employees || []).filter(function(employee) {
    if (!employee) return false;

    if (!String(employee.full_name || '').trim()) return false;

    if (!parseEmployeeBoolean_(employee.active)) return false;

    const position = String(employee.work_position || '').toLowerCase().replace(/ё/g, 'е');

    return EMPLOYEES_DIRECTORY_POSITION_PATTERNS.some(function(pattern) {
      return position.indexOf(pattern) !== -1;
    });
  });
}

/**
 * Тело пуша: только исходные поля ФИО. Нормализованные формы n8n считает
 * сам при приёме — так они гарантированно посчитаны одним кодом и не
 * едут по сети дважды.
 */
function buildEmployeesDirectoryPayload_(employees) {
  return (employees || []).map(function(employee) {
    return {
      bitrix_user_id: employee.bitrix_user_id,
      active: true,
      full_name: employee.full_name,
      short_name: employee.short_name,
      last_name: employee.last_name,
      name: employee.name,
      second_name: employee.second_name,
      work_position: employee.work_position
    };
  });
}

/**
 * POST справочника в n8n. Ничего не бросает: неуспех — это событие
 * EMPLOYEES_PUSH_ERROR в «Логе», а не сорванное обновление листа.
 *
 * Возвращает { ok, sent, response } для тоста и лога.
 */
function pushEmployeesDirectoryToN8n_(employees, force, push) {
  const log = typeof push === 'function' ? push : function() {};

  const url = String(CONFIG.N8N_EMPLOYEES_WEBHOOK_URL || '').trim();

  if (!url) {
    log('EMPLOYEES_PUSH_ERROR', '', 'Не задан CONFIG.N8N_EMPLOYEES_WEBHOOK_URL — справочник не отправлен.');
    return { ok: false, sent: 0, response: 'не задан N8N_EMPLOYEES_WEBHOOK_URL' };
  }

  const filtered = filterEmployeesForDirectory_(employees);

  if (!filtered.length) {
    log(
      'EMPLOYEES_PUSH_ERROR',
      '',
      'Под фильтр справочника не попал ни один сотрудник (активные с должностями: ' +
        EMPLOYEES_DIRECTORY_POSITION_PATTERNS.join(', ') + '). ' +
        'Пуш отменён, чтобы не затереть справочник в n8n пустым списком.'
    );

    return { ok: false, sent: 0, response: 'пустой справочник после фильтра' };
  }

  const body = JSON.stringify({
    action: 'employees_directory',
    force: force === true,
    employees: buildEmployeesDirectoryPayload_(filtered)
  });

  const options = {
    method: 'post',
    contentType: 'application/json',
    payload: body,
    muteHttpExceptions: true,
    headers: {}
  };

  options.headers[CONFIG.N8N_SECRET_HEADER] = CONFIG.N8N_SECRET;

  log(
    'EMPLOYEES_PUSH_REQUEST',
    '',
    'POST ' + url + ': ' + filtered.length + ' сотрудников из ' + (employees || []).length +
      ', ' + payloadSizeBytes_(body) + ' байт, force: ' + (force === true)
  );

  let response;

  try {
    response = UrlFetchApp.fetch(url, options);
  } catch (e) {
    log('EMPLOYEES_PUSH_ERROR', '', 'СЕТЬ: ' + String((e && e.stack) || e));
    return { ok: false, sent: 0, response: 'сеть недоступна' };
  }

  const statusCode = response.getResponseCode();
  const responseText = response.getContentText();

  if (statusCode < 200 || statusCode >= 300) {
    log(
      'EMPLOYEES_PUSH_ERROR',
      '',
      'n8n вернул HTTP ' + statusCode + ': ' + shortResponseText_(responseText) +
        (httpStatusHint_(statusCode, url) ? '. ' + httpStatusHint_(statusCode, url) : '')
    );

    return { ok: false, sent: 0, response: 'HTTP ' + statusCode };
  }

  log(
    'EMPLOYEES_PUSH_OK',
    '',
    'Справочник отправлен: ' + filtered.length + ' сотрудников, ответ n8n: ' +
      shortResponseText_(responseText)
  );

  return { ok: true, sent: filtered.length, response: shortResponseText_(responseText) };
}

/************************************************************
 * ЧТЕНИЕ СПРАВОЧНИКА
 ************************************************************/

/**
 * Лист «Сотрудники» → массив объектов по его колонкам.
 * Читается один раз за выполнение (кэш EMPLOYEES_CACHE_).
 *
 * Нет листа или он пуст — возвращаем [] и пишем EMPLOYEES_SHEET_EMPTY
 * в «Лог». Ни скан, ни отправка при этом не падают: матчинг вернёт
 * NOT_FOUND с комментарием «Справочник сотрудников пуст».
 */
function loadEmployeesFromSheet_(push) {
  if (EMPLOYEES_CACHE_) return EMPLOYEES_CACHE_;

  const sheet = SpreadsheetApp.getActive().getSheetByName(CONFIG.EMPLOYEES_SHEET_NAME);

  if (!sheet) {
    logEmployeesEvent_(
      push,
      'EMPLOYEES_SHEET_EMPTY',
      'Лист «' + CONFIG.EMPLOYEES_SHEET_NAME + '» не найден. ' +
        'Запустите «Обновить сотрудников из Битрикс».'
    );

    EMPLOYEES_CACHE_ = [];
    return EMPLOYEES_CACHE_;
  }

  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();

  if (lastRow < 2 || lastColumn < 1) {
    logEmployeesEvent_(
      push,
      'EMPLOYEES_SHEET_EMPTY',
      'Лист «' + CONFIG.EMPLOYEES_SHEET_NAME + '» пуст. ' +
        'Запустите «Обновить сотрудников из Битрикс».'
    );

    EMPLOYEES_CACHE_ = [];
    return EMPLOYEES_CACHE_;
  }

  const headerMap = getHeaderMap_(sheet);
  const values = sheet.getRange(2, 1, lastRow - 1, lastColumn).getValues();
  const employees = [];

  values.forEach(function(row) {
    const employee = {};

    EMPLOYEES_HEADERS.forEach(function(header) {
      const column = headerMap[header];
      const value = column ? row[column - 1] : '';

      employee[header] = String(value === null || value === undefined ? '' : value).trim();
    });

    if (!employee.full_name && !employee.last_name) return;

    employee.active = parseEmployeeBoolean_(
      headerMap.active ? row[headerMap.active - 1] : ''
    );

    // Подстраховка для листа, записанного старой версией скрипта:
    // потребители всегда получают готовые нормализованные формы.
    if (!employee.full_name_normalized) {
      employee.full_name_normalized = normalizeFio_(employee.full_name);
    }

    if (!employee.short_name_normalized) {
      employee.short_name_normalized = normalizeFio_(employee.short_name);
    }

    if (!employee.last_name_normalized) {
      employee.last_name_normalized = normalizeFio_(employee.last_name);
    }

    if (!employee.name_patronymic_normalized && employee.name) {
      employee.name_patronymic_normalized = normalizeFio_(
        [employee.name, employee.second_name].filter(Boolean).join(' ')
      );
    }

    employees.push(employee);
  });

  if (employees.length === 0) {
    logEmployeesEvent_(
      push,
      'EMPLOYEES_SHEET_EMPTY',
      'Лист «' + CONFIG.EMPLOYEES_SHEET_NAME + '» не содержит ни одного сотрудника.'
    );
  }

  EMPLOYEES_CACHE_ = employees;

  return EMPLOYEES_CACHE_;
}

/**
 * Снимок справочника для payload в n8n — только поля, нужные матчингу.
 * Остальные колонки листа в тело запроса не уезжают.
 */
function buildEmployeesPayload_(employees) {
  return (employees || []).map(function(employee) {
    return {
      bitrix_user_id: employee.bitrix_user_id,
      active: !!employee.active,
      full_name: employee.full_name,
      full_name_normalized: employee.full_name_normalized,
      short_name_normalized: employee.short_name_normalized,
      name_patronymic_normalized: employee.name_patronymic_normalized,
      last_name_normalized: employee.last_name_normalized,
      work_position: employee.work_position
    };
  });
}

/**
 * Лист «Операторы» — ручной маппинг «как Mango пишет нашу сторону» →
 * «ФИО сотрудника». Ведёт его пользователь: скрипт лист только читает,
 * не создаёт и не пишет. Колонки: mango_side, Сотрудник.
 *
 * Возвращает { normalizeFio_(mango_side): 'Сотрудник' } — сравнение
 * нечувствительно к регистру, «ё» и лишним пробелам.
 * Нет листа или он пуст — пустой маппинг и OPERATORS_SHEET_EMPTY в «Лог»;
 * скан при этом не падает.
 */
function loadOperatorMapping_(push) {
  if (OPERATOR_MAPPING_CACHE_) return OPERATOR_MAPPING_CACHE_;

  const mapping = {};
  const sheet = SpreadsheetApp.getActive().getSheetByName(CONFIG.OPERATORS_SHEET_NAME);

  if (!sheet || sheet.getLastRow() < 2 || sheet.getLastColumn() < 1) {
    logEmployeesEvent_(
      push,
      'OPERATORS_SHEET_EMPTY',
      'Лист «' + CONFIG.OPERATORS_SHEET_NAME + '» отсутствует или пуст: ' +
        'ручной маппинг операторов не применяется.'
    );

    OPERATOR_MAPPING_CACHE_ = mapping;
    return OPERATOR_MAPPING_CACHE_;
  }

  const headerMap = getHeaderMap_(sheet);
  const keyColumn = headerMap[OPERATORS_KEY_HEADER];
  const valueColumn = headerMap[OPERATORS_VALUE_HEADER];

  if (!keyColumn || !valueColumn) {
    logEmployeesEvent_(
      push,
      'OPERATORS_SHEET_EMPTY',
      'На листе «' + CONFIG.OPERATORS_SHEET_NAME + '» нет колонок «' +
        OPERATORS_KEY_HEADER + '» и «' + OPERATORS_VALUE_HEADER + '».'
    );

    OPERATOR_MAPPING_CACHE_ = mapping;
    return OPERATOR_MAPPING_CACHE_;
  }

  const lastRow = sheet.getLastRow();
  const values = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getValues();

  values.forEach(function(row) {
    const key = normalizeFio_(row[keyColumn - 1]);
    const value = String(row[valueColumn - 1] === null || row[valueColumn - 1] === undefined
      ? ''
      : row[valueColumn - 1]).trim();

    // Полупустая строка маппингом не является.
    if (!key || !value) return;

    // Дубликат ключа — работает первая строка, остальные только в лог.
    if (mapping[key] !== undefined) {
      logEmployeesEvent_(
        push,
        'OPERATORS_SHEET_DUPLICATE',
        'На листе «' + CONFIG.OPERATORS_SHEET_NAME + '» повторяется mango_side «' + key +
          '». Используется первое значение: ' + mapping[key] + ', пропущено: ' + value
      );

      return;
    }

    mapping[key] = value;
  });

  if (Object.keys(mapping).length === 0) {
    logEmployeesEvent_(
      push,
      'OPERATORS_SHEET_EMPTY',
      'Лист «' + CONFIG.OPERATORS_SHEET_NAME + '» не содержит ни одной пары mango_side → Сотрудник.'
    );
  }

  OPERATOR_MAPPING_CACHE_ = mapping;

  return OPERATOR_MAPPING_CACHE_;
}

/**
 * Единая реализация правил определения оператора (консолидированное ТЗ, п. 6):
 * ручной маппинг листа «Операторы» по нормализованному mango_side (он
 * авторитетнее автоматики) → matchEmployeeByName_ по «Сотрудникам» →
 * итоговое значение operator_name. Полное ФИО из справочника подставляется
 * только при надёжном статусе матчинга; иначе остаётся исходное значение,
 * а причина видна в «Логе».
 *
 * Вызывают её и scanMangoRecordingsFolder(), и recalculateOperatorNames() —
 * правила одни, вызова два.
 *
 * @param {string} mangoSide Сырое значение нашей стороны звонка (колонка mango_side).
 * @param {Array} employees Справочник из loadEmployeesFromSheet_().
 * @param {Object} operatorMapping Маппинг из loadOperatorMapping_().
 * @return {{operator_name: string, status: string, comment: string,
 *   bitrix_user_id: string, raw: string, full_name: string,
 *   mapped: string, line_name: string}}
 */
function resolveOperatorName_(mangoSide, employees, operatorMapping) {
  const side = String(mangoSide === null || mangoSide === undefined ? '' : mangoSide).trim();

  // Исходное значение оператора берём заново из mango_side, а не из текущего
  // operator_name: тот мог быть уже перезаписан прошлым пересчётом.
  const parsedSide = parseMangoSide_(side);

  const mapped = (operatorMapping || {})[normalizeFio_(side)] || '';
  const raw = mapped || parsedSide.operator_name;

  const match = matchEmployeeByName_(raw, employees);
  const matched = isConfidentEmployeeMatch_(match.status);

  return {
    operator_name: matched ? match.full_name : raw,
    status: match.status,
    comment: match.comment,
    bitrix_user_id: match.bitrix_user_id,
    raw: raw,
    full_name: match.full_name,
    mapped: mapped,
    line_name: parsedSide.line_name
  };
}

/**
 * Строка для события EMPLOYEE_MATCH_OPERATOR в «Логе».
 */
function describeOperatorResolution_(mangoSide, resolved) {
  return 'raw="' + resolved.raw + '", status=' + resolved.status +
    ', bitrix="' + resolved.full_name + '", id=' + resolved.bitrix_user_id +
    (resolved.comment ? ', comment=' + resolved.comment : '') +
    (resolved.mapped
      ? ', ручное сопоставление (лист «' + CONFIG.OPERATORS_SHEET_NAME + '»): ' +
        mangoSide + ' → ' + resolved.mapped
      : '');
}

/************************************************************
 * ПЕРЕСЧЁТ operator_name ПО ТЕКУЩИМ ЛИСТАМ «Операторы» И «Сотрудники»
 *
 * Строки, добавленные до пополнения этих листов, содержат сырое значение
 * оператора из имени файла. Пункт меню «Пересчитать операторов» проходит
 * по всем строкам «Записи звонков» и заново вычисляет operator_name теми же
 * правилами, что и скан (resolveOperatorName_).
 *
 * Запуск многократный и идемпотентный: без изменений листов повторный
 * прогон ничего не меняет. Ничего в n8n не переотправляется, никакие другие
 * колонки (status, transcription_*, результаты анализа, call_key) не трогаются.
 ************************************************************/

function recalculateOperatorNames() {
  const runId = 'operators-' + Date.now();
  const log = [];

  const push = function(step, file, details) {
    log.push([
      nowString_(),
      runId,
      String(step || ''),
      String(file || '').slice(0, 300),
      String(details || '').slice(0, 2000)
    ]);
  };

  const lock = LockService.getScriptLock();

  if (!lock.tryLock(SHEET_LOCK_TIMEOUT_MS)) {
    push(
      'OPERATOR_RECALC_LOCKED',
      '',
      'Пересчёт/скан/обновление сотрудников уже выполняется (lock не получен за ' +
        SHEET_LOCK_TIMEOUT_MS + ' мс). Запуск пропущен.'
    );

    flushLog_(log);
    showToast_('Пересчёт уже выполняется');
    return;
  }

  try {
    push(
      'OPERATOR_RECALC_START',
      '',
      'Пересчёт operator_name по листам «' + CONFIG.OPERATORS_SHEET_NAME + '» и «' +
        CONFIG.EMPLOYEES_SHEET_NAME + '»'
    );

    const sheet = getOrCreateSheet_();
    ensureHeaders_(sheet);

    const headerMap = getHeaderMap_(sheet);
    const operatorColumn = headerMap.operator_name;

    if (!operatorColumn) {
      throw new Error('На листе «' + CONFIG.SHEET_NAME + '» нет колонки operator_name.');
    }

    const mangoSideColumn = headerMap.mango_side;

    if (!mangoSideColumn) {
      throw new Error('На листе «' + CONFIG.SHEET_NAME + '» нет колонки mango_side.');
    }

    const updatedAtColumn = headerMap.updated_at;
    const lastRow = sheet.getLastRow();

    if (lastRow < 2) {
      push('OPERATOR_RECALC_FINISH', '', 'Строк проверено: 0, изменено: 0, пропущено (ошибки парсинга): 0');
      showToast_('Пересчёт операторов: изменено 0 из 0');
      return;
    }

    // Справочники читаются по одному разу за прогон.
    const employees = loadEmployeesFromSheet_(push);
    const operatorMapping = loadOperatorMapping_(push);

    // Лист читается одним getValues.
    const rowCount = lastRow - 1;
    const values = sheet.getRange(2, 1, rowCount, sheet.getLastColumn()).getValues();

    const now = nowString_();

    // Снимки колонок: изменения вносим в них, а пишем блоками (см. ниже).
    const operatorColumnValues = values.map(function(row) {
      return [row[operatorColumn - 1]];
    });

    const updatedAtColumnValues = updatedAtColumn
      ? values.map(function(row) { return [row[updatedAtColumn - 1]]; })
      : null;

    let checked = 0;
    let changed = 0;
    let skipped = 0;

    const changedRowNumbers = [];
    const samples = [];

    values.forEach(function(row, index) {
      const rowNumber = index + 2;

      const mangoSide = String(row[mangoSideColumn - 1] === null || row[mangoSideColumn - 1] === undefined
        ? ''
        : row[mangoSideColumn - 1]).trim();

      // Строки с ошибкой разбора имени файла: mango_side пуст, вычислять
      // оператора не из чего.
      if (!mangoSide) {
        skipped++;
        return;
      }

      checked++;

      const resolved = resolveOperatorName_(mangoSide, employees, operatorMapping);

      const oldValue = String(row[operatorColumn - 1] === null || row[operatorColumn - 1] === undefined
        ? ''
        : row[operatorColumn - 1]).trim();

      const newValue = String(resolved.operator_name || '');

      // Значение не изменилось — строку не трогаем.
      if (newValue === oldValue) return;

      operatorColumnValues[index][0] = newValue;

      if (updatedAtColumnValues) updatedAtColumnValues[index][0] = now;

      changedRowNumbers.push(rowNumber);
      changed++;

      if (samples.length < OPERATOR_RECALC_LOG_SAMPLE_LIMIT) {
        samples.push(
          (oldValue || '(пусто)') + ' → ' + (newValue || '(пусто)') + ' (строка ' + rowNumber + ')'
        );
      }
    });

    if (changedRowNumbers.length > 0) {
      const blocks = collectWriteBlocks_(changedRowNumbers, OPERATOR_RECALC_MAX_WRITE_GAP);

      push(
        'OPERATOR_RECALC_WRITE',
        '',
        'Запись изменений: строк ' + changedRowNumbers.length + ', диапазонов ' + blocks.length
      );

      blocks.forEach(function(block) {
        const offset = block.start - 2;
        const height = block.end - block.start + 1;

        sheet
          .getRange(block.start, operatorColumn, height, 1)
          .setValues(operatorColumnValues.slice(offset, offset + height));

        if (updatedAtColumnValues) {
          sheet
            .getRange(block.start, updatedAtColumn, height, 1)
            .setValues(updatedAtColumnValues.slice(offset, offset + height));
        }
      });
    }

    const details =
      'Строк проверено: ' + checked +
      ', изменено: ' + changed +
      ', пропущено (ошибки парсинга): ' + skipped +
      (samples.length ? '. Изменения: ' + samples.join('; ') : '');

    push('OPERATOR_RECALC_FINISH', '', details);
    showToast_('Пересчёт операторов: изменено ' + changed + ' из ' + checked);

  } catch (e) {
    push('OPERATOR_RECALC_ERROR', '', String((e && e.stack) || e));
    showToast_('Ошибка пересчёта операторов: ' + String((e && e.message) || e));
    throw e;
  } finally {
    lock.releaseLock();
    flushLog_(log);
  }
}

/************************************************************
 * ОБНОВЛЕНИЕ СПИСКА mango_side НА ЛИСТЕ «Операторы»
 *
 * Пункт меню «Обновить mango side»: собирает уникальные значения
 * mango_side с листа «Записи звонков» и дописывает отсутствующие
 * снизу листа «Операторы». Колонка «Сотрудник» у новых строк
 * остаётся пустой — её заполняет пользователь.
 *
 * Сравнение значений — по normalizeFio_, как в loadOperatorMapping_:
 * регистр, «ё» и лишние пробелы различий не создают. На лист попадает
 * первый встретившийся сырой вариант значения.
 *
 * Результат показывается модальным окном: список добавленных значений
 * либо сообщение, что новых нет. Запуск идемпотентен: повторный прогон
 * без новых звонков ничего не дописывает.
 ************************************************************/

function updateMangoSideList() {
  const runId = 'mango-side-' + Date.now();
  const log = [];

  const push = function(step, file, details) {
    log.push([
      nowString_(),
      runId,
      String(step || ''),
      String(file || '').slice(0, 300),
      String(details || '').slice(0, 2000)
    ]);
  };

  const lock = LockService.getScriptLock();

  if (!lock.tryLock(SHEET_LOCK_TIMEOUT_MS)) {
    push(
      'MANGO_SIDE_UPDATE_LOCKED',
      '',
      'Другая операция уже выполняется (lock не получен за ' +
        SHEET_LOCK_TIMEOUT_MS + ' мс). Запуск пропущен.'
    );

    flushLog_(log);
    showToast_('Обновление mango side: другая операция уже выполняется');
    return;
  }

  try {
    push(
      'MANGO_SIDE_UPDATE_START',
      '',
      'Сбор уникальных mango_side с листа «' + CONFIG.SHEET_NAME + '»'
    );

    const callsSheet = SpreadsheetApp.getActive().getSheetByName(CONFIG.SHEET_NAME);

    if (!callsSheet) {
      throw new Error('Лист «' + CONFIG.SHEET_NAME + '» не найден.');
    }

    const callsHeaderMap = getHeaderMap_(callsSheet);
    const mangoSideColumn = callsHeaderMap.mango_side;

    if (!mangoSideColumn) {
      throw new Error('На листе «' + CONFIG.SHEET_NAME + '» нет колонки mango_side.');
    }

    // Уникальные значения со звонков: ключ — normalizeFio_, значение —
    // первый встретившийся сырой вариант (он и попадёт на лист).
    // Пустые mango_side (строки с ошибкой разбора имени файла) пропускаются.
    const seen = {};
    const lastCallRow = callsSheet.getLastRow();

    if (lastCallRow >= 2) {
      callsSheet
        .getRange(2, mangoSideColumn, lastCallRow - 1, 1)
        .getValues()
        .forEach(function(row) {
          const raw = String(row[0] === null || row[0] === undefined ? '' : row[0]).trim();
          if (!raw) return;

          const key = normalizeFio_(raw);
          if (!key) return;

          if (seen[key] === undefined) seen[key] = raw;
        });
    }

    // Лист «Операторы»: отсутствует или пуст — создаётся/размечается
    // заголовками mango_side и Сотрудник.
    let operatorsSheet = SpreadsheetApp.getActive().getSheetByName(CONFIG.OPERATORS_SHEET_NAME);

    if (!operatorsSheet) {
      operatorsSheet = SpreadsheetApp.getActive().insertSheet(CONFIG.OPERATORS_SHEET_NAME);
    }

    if (operatorsSheet.getLastRow() < 1 || operatorsSheet.getLastColumn() < 1) {
      operatorsSheet
        .getRange(1, 1, 1, 2)
        .setValues([[OPERATORS_KEY_HEADER, OPERATORS_VALUE_HEADER]]);

      push(
        'MANGO_SIDE_SHEET_CREATED',
        '',
        'Лист «' + CONFIG.OPERATORS_SHEET_NAME + '» размечен колонками «' +
          OPERATORS_KEY_HEADER + '» и «' + OPERATORS_VALUE_HEADER + '».'
      );
    }

    const operatorsHeaderMap = getHeaderMap_(operatorsSheet);
    const keyColumn = operatorsHeaderMap[OPERATORS_KEY_HEADER];

    if (!keyColumn) {
      throw new Error(
        'На листе «' + CONFIG.OPERATORS_SHEET_NAME + '» нет колонки «' +
          OPERATORS_KEY_HEADER + '».'
      );
    }

    // Значения, уже известные листу, — по тому же нормализованному ключу.
    const known = {};
    const lastOperatorRow = operatorsSheet.getLastRow();

    if (lastOperatorRow >= 2) {
      operatorsSheet
        .getRange(2, keyColumn, lastOperatorRow - 1, 1)
        .getValues()
        .forEach(function(row) {
          const key = normalizeFio_(row[0]);
          if (key) known[key] = true;
        });
    }

    const added = [];

    Object.keys(seen).forEach(function(key) {
      if (!known[key]) added.push(seen[key]);
    });

    added.sort(function(a, b) { return a.localeCompare(b, 'ru'); });

    if (added.length) {
      operatorsSheet
        .getRange(lastOperatorRow + 1, keyColumn, added.length, 1)
        .setValues(added.map(function(value) { return [value]; }));
    }

    const details =
      'Уникальных mango_side в звонках: ' + Object.keys(seen).length +
      ', на листе было: ' + Object.keys(known).length +
      ', добавлено: ' + added.length +
      (added.length ? '. Новые: ' + added.join('; ') : '');

    push('MANGO_SIDE_UPDATE_FINISH', '', details);

    if (added.length) {
      showAlert_(
        'Обновить mango side',
        'Добавлено новых значений: ' + added.length + '\n\n' +
          added.join('\n') + '\n\n' +
          'Заполните колонку «' + OPERATORS_VALUE_HEADER + '» на листе «' +
          CONFIG.OPERATORS_SHEET_NAME + '».'
      );
    } else {
      showAlert_('Обновить mango side', 'Новых значений mango_side нет.');
    }

  } catch (e) {
    push('MANGO_SIDE_UPDATE_ERROR', '', String((e && e.stack) || e));
    showAlert_('Обновить mango side', 'Ошибка: ' + String((e && e.message) || e));
    throw e;
  } finally {
    lock.releaseLock();
    flushLog_(log);
  }
}

/**
 * Номера изменённых строк → диапазоны для батчевой записи.
 * Соседние и близкие строки (разрыв ≤ maxGap) объединяются в один диапазон:
 * в промежутке записываются те же значения, что там уже стоят.
 *
 * [3, 4, 5, 40, 41] при maxGap = 25 → [{start: 3, end: 5}, {start: 40, end: 41}]
 */
function collectWriteBlocks_(rowNumbers, maxGap) {
  const gap = Math.max(1, Number(maxGap) || 1);
  const sorted = (rowNumbers || []).slice().sort(function(a, b) { return a - b; });
  const blocks = [];

  sorted.forEach(function(rowNumber) {
    const last = blocks[blocks.length - 1];

    if (last && rowNumber - last.end <= gap) {
      last.end = rowNumber;
      return;
    }

    blocks.push({ start: rowNumber, end: rowNumber });
  });

  return blocks;
}

/**
 * Событие справочника в «Лог». push есть у скана и отправки; без него
 * (например, при вызове из редактора) пишем строку в лист напрямую.
 */
function logEmployeesEvent_(push, step, details) {
  if (typeof push === 'function') {
    push(step, '', details);
    return;
  }

  flushLog_([[nowString_(), 'employees-' + Date.now(), step, '', String(details || '')]]);
}

/**
 * ACTIVE из Битрикс приходит как boolean, 'Y'/'N' или строкой;
 * с листа — как чекбокс или текст TRUE/FALSE.
 */
function parseEmployeeBoolean_(value) {
  if (value === true) return true;
  if (value === false) return false;

  const s = String(value === null || value === undefined ? '' : value).trim().toLowerCase();

  return ['true', 'y', 'yes', '1', 'да', 'истина'].indexOf(s) !== -1;
}

/************************************************************
 * МАТЧИНГ ФИО ПО СПРАВОЧНИКУ
 *
 * ВНИМАНИЕ: JS-копия этого алгоритма (normalizeFio_ + matchEmployeeByName_)
 * живёт в n8n.json, нода «Prepare Sheet Update» — она матчит
 * requested_specialist и appointment_specialist. Реализации обязаны быть
 * идентичны: менять их нужно синхронно.
 *
 * Никакого fuzzy-матчинга: неуверенное совпадение — это NOT_FOUND,
 * а не подстановка похожего сотрудника.
 ************************************************************/

/**
 * Нормализация ФИО:
 *   нижний регистр; ё → е; служебные символы (точки, запятые, кавычки)
 *   → пробел; несколько пробелов → один; trim.
 *
 *   Кузнецов Максим Николаевич → кузнецов максим николаевич
 *   Кузнецов М. Н.            → кузнецов м н
 *   Кузнецов МН               → кузнецов мн
 */
function normalizeFio_(text) {
  return String(text === null || text === undefined ? '' : text)
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/[^0-9a-zа-я]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

/**
 * Ключ короткой формы: фамилия + слитные инициалы.
 *   «солопова о с» → { last: 'солопова', initials: 'ос' }
 *   «кузнецов мн»  → { last: 'кузнецов', initials: 'мн' }
 *   «кузнецов максим николаевич» → null (это не короткая форма)
 *
 * Инициалы склеиваются, поэтому «Кузнецов М. Н.» и «Кузнецов МН» дают
 * один и тот же ключ.
 */
function fioShortKey_(normalized) {
  const tokens = String(normalized || '').split(' ').filter(Boolean);

  if (tokens.length < 2) return null;

  const rest = tokens.slice(1);

  // Инициал — токен из одной буквы либо один слитный блок из двух.
  for (let i = 0; i < rest.length; i++) {
    if (rest[i].length > 2) return null;
  }

  const initials = rest.join('');

  // У человека максимум два инициала: имя и отчество.
  if (!initials || initials.length > 2) return null;

  return { last: tokens[0], initials: initials };
}

/**
 * Совпадение коротких форм. Mango часто даёт только первый инициал
 * («Солопова О»), а в справочнике их два («Солопова О С»), поэтому
 * более короткий набор инициалов должен быть началом более длинного.
 * Неоднозначность этим не маскируется: несколько подошедших сотрудников
 * дают AMBIGUOUS и автоподстановки не будет.
 *
 * useBase — сравнивать фамилии в базовой (беспадежной) форме.
 */
function matchesFioShortForm_(inputKey, employeeShortNormalized, useBase) {
  if (!inputKey) return false;

  const employeeKey = fioShortKey_(employeeShortNormalized);

  if (!employeeKey) return false;

  const employeeLast = useBase ? stripFioCaseEnding_(employeeKey.last) : employeeKey.last;

  if (inputKey.last !== employeeLast) return false;

  return inputKey.initials.indexOf(employeeKey.initials) === 0 ||
    employeeKey.initials.indexOf(inputKey.initials) === 0;
}

// Частые падежные окончания фамилий. Длинные — раньше коротких.
const FIO_CASE_ENDINGS = ['ому', 'ему', 'ым', 'им', 'ой', 'ей', 'а', 'у', 'ю'];

/**
 * Базовая форма фамилии: отсекает падежное окончание.
 * Основа короче трёх букв не признаётся — «Ким», «Цой» остаются как есть.
 */
function stripFioCaseEnding_(token) {
  const s = String(token || '');

  for (let i = 0; i < FIO_CASE_ENDINGS.length; i++) {
    const ending = FIO_CASE_ENDINGS[i];

    if (s.length - ending.length >= 3 && s.slice(-ending.length) === ending) {
      return s.slice(0, s.length - ending.length);
    }
  }

  return s;
}

/**
 * Базовая форма всей строки: падежное окончание снимается с первого
 * токена (фамилии), остальные части остаются как есть.
 */
function baseFioForm_(normalized) {
  const tokens = String(normalized || '').split(' ').filter(Boolean);

  if (tokens.length === 0) return '';

  tokens[0] = stripFioCaseEnding_(tokens[0]);

  return tokens.join(' ');
}

/**
 * Сопоставление имени со справочником.
 *
 * Возвращает { status, bitrix_user_id, full_name, comment }, где status —
 * EXACT | SHORT_EXACT | NAME_PATRONYMIC_UNIQUE | LASTNAME_UNIQUE |
 * NOT_FOUND | AMBIGUOUS | EMPTY.
 *
 * Порядок правил (первое сработавшее останавливает поиск):
 *   1. пустое имя → EMPTY;
 *   2. полное ФИО → EXACT;
 *   3. короткая форма «Фамилия И О», в т.ч. со слитными инициалами → SHORT_EXACT;
 *   4. «Имя Отчество» → NAME_PATRONYMIC_UNIQUE (имя без отчества не матчится);
 *   5. одна фамилия → LASTNAME_UNIQUE;
 *   6. падежная форма фамилии, только при единственном кандидате → LASTNAME_UNIQUE;
 *   7. иначе → NOT_FOUND.
 *
 * Несколько кандидатов на любом шаге — AMBIGUOUS, автоподстановки нет.
 * options.activeOnly (по умолчанию true) — матчить только active = TRUE.
 */
function matchEmployeeByName_(name, employees, options) {
  const activeOnly = !(options && options.activeOnly === false);

  const result = {
    status: 'EMPTY',
    bitrix_user_id: '',
    full_name: '',
    comment: ''
  };

  const raw = String(name === null || name === undefined ? '' : name).trim();
  const normalized = normalizeFio_(raw);

  if (!normalized) {
    result.comment = 'Имя не указано';
    return result;
  }

  const list = (employees || []).filter(function(employee) {
    return activeOnly ? !!employee.active : true;
  });

  if (list.length === 0) {
    result.status = 'NOT_FOUND';
    result.comment = 'Справочник сотрудников пуст';
    return result;
  }

  const shortKey = fioShortKey_(normalized);

  // «Михаил Сергеевич» — минимум два токена. Одно имя («Михаил») никого
  // не идентифицирует и по имени-отчеству не матчится.
  const hasPatronymic = normalized.split(' ').filter(Boolean).length >= 2;

  const steps = [
    {
      status: 'EXACT',
      test: function(employee) {
        return employee.full_name_normalized === normalized;
      }
    },
    {
      status: 'SHORT_EXACT',
      test: function(employee) {
        return employee.short_name_normalized === normalized ||
          matchesFioShortForm_(shortKey, employee.short_name_normalized, false);
      }
    },
    {
      status: 'NAME_PATRONYMIC_UNIQUE',
      comment: 'совпадение по имени и отчеству',
      test: function(employee) {
        return hasPatronymic &&
          !!employee.name_patronymic_normalized &&
          employee.name_patronymic_normalized === normalized;
      }
    },
    {
      status: 'LASTNAME_UNIQUE',
      test: function(employee) {
        return employee.last_name_normalized === normalized;
      }
    }
  ];

  for (let i = 0; i < steps.length; i++) {
    const found = list.filter(steps[i].test);

    if (found.length === 1) {
      result.status = steps[i].status;
      result.bitrix_user_id = found[0].bitrix_user_id;
      result.full_name = found[0].full_name;
      result.comment = steps[i].comment || '';
      return result;
    }

    if (found.length > 1) {
      result.status = 'AMBIGUOUS';
      result.comment = describeEmployeeCandidates_(found);
      return result;
    }
  }

  // Падежные формы: «Коныховой», «Кузнецову». Статус не поднимается выше
  // LASTNAME_UNIQUE и допускается только при единственном кандидате.
  // К имени-отчеству падежный шаг не применяется.
  const base = baseFioForm_(normalized);
  const baseKey = fioShortKey_(base);

  const byCase = list.filter(function(employee) {
    return baseFioForm_(employee.full_name_normalized) === base ||
      baseFioForm_(employee.short_name_normalized) === base ||
      matchesFioShortForm_(baseKey, employee.short_name_normalized, true) ||
      stripFioCaseEnding_(employee.last_name_normalized) === base;
  });

  if (byCase.length === 1) {
    result.status = 'LASTNAME_UNIQUE';
    result.bitrix_user_id = byCase[0].bitrix_user_id;
    result.full_name = byCase[0].full_name;
    result.comment = 'падежная форма: ' + raw + ' → ' + base;
    return result;
  }

  if (byCase.length > 1) {
    result.status = 'AMBIGUOUS';
    result.comment = describeEmployeeCandidates_(byCase);
    return result;
  }

  result.status = 'NOT_FOUND';
  result.comment = 'Не найдено надежное совпадение в справочнике сотрудников';

  return result;
}

/**
 * Автоподстановка ФИО разрешена только при этих статусах.
 */
function isConfidentEmployeeMatch_(status) {
  return ['EXACT', 'SHORT_EXACT', 'NAME_PATRONYMIC_UNIQUE', 'LASTNAME_UNIQUE']
    .indexOf(String(status || '')) !== -1;
}

/**
 * «Найдено несколько сотрудников: Иванова Анна (12), Иванова Алла (57)»
 */
function describeEmployeeCandidates_(candidates) {
  return 'Найдено несколько сотрудников: ' + candidates
    .slice(0, 10)
    .map(function(employee) {
      return employee.full_name + ' (' + employee.bitrix_user_id + ')';
    })
    .join(', ');
}

/**
 * Toast без падения в триггерном контексте, где UI недоступен.
 */
function showToast_(message) {
  try {
    SpreadsheetApp.getActive().toast(String(message || ''));
  } catch (e) {
    Logger.log(message);
  }
}

/************************************************************
 * CALL KEY
 ************************************************************/

/**
 * Новый ключ: дата__время__телефон из РАЗОБРАННЫХ данных.
 * Не зависит от кодировки имени файла: как бы ни была испорчена
 * кириллица, цифры даты/времени/телефона всегда доезжают целыми,
 * поэтому один и тот же звонок при любом экспорте даёт один ключ.
 * Если разбор не удался — fallback на каноническое имя файла.
 */
function buildCallKey_(parsed, filenameFixed) {
  if (parsed && parsed.call_date && parsed.call_time && parsed.client_phone) {
    return parsed.call_date + '__' + parsed.call_time.replace(/:/g, '-') + '__' + parsed.client_phone;
  }

  return buildLegacyCallKey_(filenameFixed);
}

/**
 * Старый ключ (имя файла без расширения) — для сверки со строками,
 * добавленными до перехода на новый формат.
 */
function buildLegacyCallKey_(filenameFixed) {
  const base = stripExtension_(filenameFixed).trim();

  if (!base) return '';

  return base
    .replace(/\s+/g, ' ')
    .trim();
}

/************************************************************
 * PARSE MANGO FILENAME
 ************************************************************/

/**
 * Форматы:
 *
 * OUTBOUND / мы звоним:
 * 2026-06-05__10-27-54__Продажи 2 Шкляр А__79378511104.mp3
 *
 * INBOUND / нам звонят:
 * 2026-06-05__10-40-03__79203381996__Продажи 4 Солопова О.mp3
 */
function parseMangoFilename_(filenameFixed) {
  const base = stripExtension_(filenameFixed);
  const parts = base.split('__').map(p => String(p || '').trim());

  const result = {
    call_datetime: '',
    call_date: '',
    call_time: '',

    direction: '',
    client_phone: '',
    mango_side: '',
    line_name: '',
    operator_name: '',

    error_text: ''
  };

  if (parts.length < 4) {
    result.error_text = 'Не удалось разобрать имя файла: ожидается минимум 4 блока через "__"';
    return result;
  }

  const datePart = parts[0];
  const timePartRaw = parts[1];
  const timePart = timePartRaw.replace(/-/g, ':');

  result.call_date = datePart;
  result.call_time = timePart;
  result.call_datetime = datePart + ' ' + timePart;

  const payloadParts = parts.slice(2);

  const firstPayload = payloadParts[0];
  const lastPayload = payloadParts[payloadParts.length - 1];

  const firstIsPhone = isPhone_(firstPayload);
  const lastIsPhone = isPhone_(lastPayload);

  if (firstIsPhone && !lastIsPhone) {
    result.direction = 'INBOUND';
    result.client_phone = firstPayload;
    result.mango_side = payloadParts.slice(1).join('__').trim();

  } else if (!firstIsPhone && lastIsPhone) {
    result.direction = 'OUTBOUND';
    result.client_phone = lastPayload;
    result.mango_side = payloadParts.slice(0, payloadParts.length - 1).join('__').trim();

  } else if (firstIsPhone && lastIsPhone) {
    result.error_text = 'Неоднозначное имя файла: телефон найден и в начале, и в конце блока после времени';
    return result;

  } else {
    result.error_text = 'Не найден телефон клиента ни в начале, ни в конце блока после времени';
    return result;
  }

  const sideParsed = parseMangoSide_(result.mango_side);

  result.line_name = sideParsed.line_name;
  result.operator_name = sideParsed.operator_name;

  const problems = [];

  if (!/^\d{4}-\d{2}-\d{2}$/.test(datePart)) {
    problems.push('Некорректная дата: ' + datePart);
  }

  if (!/^\d{2}:\d{2}:\d{2}$/.test(timePart)) {
    problems.push('Некорректное время: ' + timePartRaw);
  }

  if (!result.client_phone || !isPhone_(result.client_phone)) {
    problems.push('Некорректный телефон клиента: ' + result.client_phone);
  }

  if (!result.mango_side) {
    problems.push('Не определена наша сторона звонка');
  }

  if (!result.direction) {
    problems.push('Не определено направление звонка');
  }

  result.error_text = problems.join('; ');

  return result;
}

function parseMangoSide_(mangoSide) {
  const text = humanizeSipName_(String(mangoSide || '').trim());
  const tokens = text.split(/\s+/).filter(Boolean);

  const result = {
    line_name: text,
    operator_name: ''
  };

  // У Roistat-линий оператора в имени нет — не пытаемся его выделять.
  if (!/^Roistat\b/i.test(text) && tokens.length >= 3) {
    result.operator_name = tokens.slice(-2).join(' ');
    result.line_name = tokens.slice(0, -2).join(' ');
  }

  return result;
}

/**
 * sip_79310093200@pbx.roistat.com → «Roistat 79310093200»
 * или название из SIP_LINE_NAMES, если задано.
 */
function humanizeSipName_(text) {
  const match = String(text || '').match(/^sip_(\d{7,15})@pbx\.roistat\.com$/i);

  if (!match) return text;

  const number = match[1];
  const custom = String(SIP_LINE_NAMES[number] || '').trim();

  return custom || ('Roistat ' + number);
}

/************************************************************
 * HELPERS: SHEET
 ************************************************************/

function getOrCreateSheet_() {
  const ss = SpreadsheetApp.getActive();
  let sheet = ss.getSheetByName(CONFIG.SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(CONFIG.SHEET_NAME);
  }

  return sheet;
}

function ensureHeaders_(sheet) {
  ensureSheetHeaders_(sheet, HEADERS);
  ensureDurationColumnFormats_(sheet);
}

/**
 * Принудительный формат колонок длительности + разовая починка значений,
 * уже испорченных форматом даты.
 *
 * Идемпотентно и выполняется при каждом обеспечении заголовков: если
 * формат колонки снова собьётся (копирование, ручная правка), следующий
 * запуск скана или отправки его восстановит.
 */
function ensureDurationColumnFormats_(sheet) {
  const headerMap = getHeaderMap_(sheet);
  const maxRows = sheet.getMaxRows();

  if (maxRows < 2) return;

  Object.keys(DURATION_COLUMN_FORMATS).forEach(function(header) {
    const column = headerMap[header];

    if (!column) return;

    // Весь столбец без строки заголовка: формат держится и на пустых
    // строках, поэтому новые записи его наследуют.
    sheet
      .getRange(2, column, maxRows - 1, 1)
      .setNumberFormat(DURATION_COLUMN_FORMATS[header]);
  });

  repairDurationValues_(sheet, headerMap);
}

/**
 * Разовая починка значений, испорченных форматом даты.
 *
 * call_duration_seconds: если в ячейке число, достаточно setNumberFormat
 * выше — оно сразу отображается числом. Если запись через API превратила
 * его в дату-объект, исходное число возвращается из серийного числа даты
 * (дни от 1899-12-30) — оно и есть записанные секунды.
 *
 * call_duration: дату-объект восстанавливаем НЕ из её серийного числа —
 * «2:20» Sheets мог разобрать и как 2 ч 20 мин, и как 2 мин 20 сек. Текст
 * пересобирается из call_duration_seconds той же строки: это единственное
 * значение, которому можно верить. Нет секунд — ячейку не трогаем.
 *
 * Возвращает количество починенных ячеек.
 */
function repairDurationValues_(sheet, headerMap) {
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return 0;

  const height = lastRow - 1;
  const timeZone = sheet.getParent().getSpreadsheetTimeZone();
  const secondsColumn = headerMap.call_duration_seconds;
  const durationColumn = headerMap.call_duration;

  const secondsValues = secondsColumn
    ? sheet.getRange(2, secondsColumn, height, 1).getValues()
    : null;

  const fixedSecondsRows = [];

  if (secondsValues) {
    secondsValues.forEach(function(row, index) {
      if (!isDateValue_(row[0])) return;

      const seconds = sheetSerialSeconds_(row[0], timeZone);

      if (seconds === null) return;

      secondsValues[index][0] = seconds;
      fixedSecondsRows.push(index + 2);
    });
  }

  const durationValues = durationColumn
    ? sheet.getRange(2, durationColumn, height, 1).getValues()
    : null;

  const fixedDurationRows = [];

  if (durationValues) {
    durationValues.forEach(function(row, index) {
      if (!isDateValue_(row[0])) return;

      const seconds = secondsValues ? Number(secondsValues[index][0]) : NaN;

      if (!Number.isFinite(seconds) || seconds <= 0) return;

      durationValues[index][0] = formatCallDuration_(seconds);
      fixedDurationRows.push(index + 2);
    });
  }

  writeRepairedColumn_(sheet, secondsColumn, secondsValues, fixedSecondsRows);
  writeRepairedColumn_(sheet, durationColumn, durationValues, fixedDurationRows);

  return fixedSecondsRows.length + fixedDurationRows.length;
}

/**
 * Запись починенных строк блоками: соседние строки — одним диапазоном,
 * в промежутках записываются те же значения, что там уже стоят.
 */
function writeRepairedColumn_(sheet, column, values, fixedRowNumbers) {
  if (!column || !values || !fixedRowNumbers.length) return;

  collectWriteBlocks_(fixedRowNumbers, OPERATOR_RECALC_MAX_WRITE_GAP).forEach(function(block) {
    const height = block.end - block.start + 1;
    const blockValues = values.slice(block.start - 2, block.start - 2 + height);

    sheet.getRange(block.start, column, height, 1).setValues(blockValues);
  });
}

function isDateValue_(value) {
  return Object.prototype.toString.call(value) === '[object Date]';
}

/**
 * Дата из ячейки → её серийное число Google Sheets (дни от 1899-12-30).
 * Для колонки секунд это ровно то число, которое было записано.
 *
 * Дата разбирается в часовом поясе таблицы — в нём Sheets её и построил,
 * поэтому пояс скрипта на результат не влияет.
 */
function sheetSerialSeconds_(date, timeZone) {
  const parts = Utilities
    .formatDate(date, timeZone, 'yyyy-MM-dd-HH-mm-ss')
    .split('-')
    .map(Number);

  const dayMs = Date.UTC(parts[0], parts[1] - 1, parts[2]);
  const days = (dayMs - SHEET_SERIAL_EPOCH_UTC_MS) / MS_PER_DAY;
  const dayFraction = (parts[3] * 3600 + parts[4] * 60 + parts[5]) / 86400;

  // Секунды всегда целые (их округляет n8n), поэтому дробная часть — это
  // только погрешность старых часовых поясов, и её снимает округление.
  const seconds = Math.round(days + dayFraction);

  return Number.isFinite(seconds) && seconds > 0 ? seconds : null;
}

/**
 * Секунды → «4:07», при часе и более «1:02:33».
 * Тот же формат, что делает нода Build Analysis Request в n8n.json.
 */
function formatCallDuration_(seconds) {
  const total = Math.round(Number(seconds));

  if (!Number.isFinite(total) || total <= 0) return '';

  const pad = function(n) { return String(n).length < 2 ? '0' + n : String(n); };

  const hours = Math.floor(total / 3600);
  const minutes = Math.floor((total % 3600) / 60);
  const rest = total % 60;

  return hours > 0
    ? hours + ':' + pad(minutes) + ':' + pad(rest)
    : minutes + ':' + pad(rest);
}

/**
 * Дописывает недостающие заголовки, ничего не удаляя и не сдвигая.
 * Новые колонки добавляются ПОСЛЕ последней непустой ячейки шапки —
 * по её фактической позиции, а не по количеству заголовков: колонки,
 * которых больше нет в HEADERS (старый контракт v1), остаются на месте
 * вместе со своими данными.
 */
function ensureSheetHeaders_(sheet, headers) {
  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();

  if (lastRow === 0 || lastColumn === 0) {
    ensureSheetColumnCount_(sheet, headers.length);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    return;
  }

  const firstRow = sheet
    .getRange(1, 1, 1, lastColumn)
    .getValues()[0]
    .map(String)
    .map(s => s.trim());

  const existing = {};
  let lastHeaderColumn = 0;

  firstRow.forEach(function(header, index) {
    if (!header) return;

    lastHeaderColumn = index + 1;
    if (existing[header] === undefined) existing[header] = index + 1;
  });

  if (lastHeaderColumn === 0) {
    ensureSheetColumnCount_(sheet, headers.length);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    return;
  }

  const missing = headers.filter(h => existing[h] === undefined);

  if (missing.length > 0) {
    ensureSheetColumnCount_(sheet, lastHeaderColumn + missing.length);

    sheet
      .getRange(1, lastHeaderColumn + 1, 1, missing.length)
      .setValues([missing]);
  }

  sheet.setFrozenRows(1);
}

/**
 * Расширяет лист вправо, если колонок физически меньше, чем нужно.
 */
function ensureSheetColumnCount_(sheet, needed) {
  const maxColumns = sheet.getMaxColumns();

  if (maxColumns < needed) {
    sheet.insertColumnsAfter(maxColumns, needed - maxColumns);
  }
}

function getHeaderMap_(sheet) {
  const headers = sheet
    .getRange(1, 1, 1, sheet.getLastColumn())
    .getValues()[0]
    .map(String)
    .map(s => s.trim());

  const map = {};

  headers.forEach((h, index) => {
    if (h) map[h] = index + 1;
  });

  return map;
}

function loadExistingCallKeys_(sheet, headerMap) {
  const set = new Set();

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return set;

  // Учитываем и call_key, и старые ключи-имена (filename_fixed без
  // расширения) — чтобы строки старого формата тоже считались дублями.
  const callKeyCol = headerMap.call_key;
  const fixedCol = headerMap.filename_fixed;

  if (callKeyCol) {
    sheet.getRange(2, callKeyCol, lastRow - 1, 1).getValues().forEach(row => {
      const key = String(row[0] || '').trim();
      if (key) set.add(key);
    });
  }

  if (fixedCol) {
    sheet.getRange(2, fixedCol, lastRow - 1, 1).getValues().forEach(row => {
      const legacy = buildLegacyCallKey_(String(row[0] || ''));
      if (legacy) set.add(legacy);
    });
  }

  return set;
}

/**
 * Строит строку по фактическим позициям колонок листа,
 * а не по порядку в HEADERS — безопасно при любом
 * расположении колонок.
 */
function makeRowByHeaders_(obj, headerMap, lastColumn) {
  const width = Math.max(lastColumn, 1);
  const row = new Array(width).fill('');

  Object.keys(obj).forEach(function(header) {
    const column = headerMap[header];
    if (column && column <= width) {
      row[column - 1] = obj[header];
    }
  });

  return row;
}

function getCellByHeader_(row, headerMap, headerName) {
  const col = headerMap[headerName];

  if (!col) return '';

  return String(row[col - 1] || '').trim();
}

function setCellByHeader_(sheet, rowIndex, headerMap, headerName, value) {
  const col = headerMap[headerName];

  if (!col) {
    throw new Error('Не найдена колонка: ' + headerName);
  }

  sheet.getRange(rowIndex, col).setValue(value);
}

function columnToLetter_(column) {
  let letter = '';
  let n = Number(column);

  while (n > 0) {
    const mod = (n - 1) % 26;
    letter = String.fromCharCode(65 + mod) + letter;
    n = Math.floor((n - 1) / 26);
  }

  return letter;
}

