function isPhone_(value) {
  return /^\d{7,15}$/.test(String(value || '').trim());
}

function isMp3_(filename) {
  return /\.mp3$/i.test(String(filename || ''));
}

function stripExtension_(filename) {
  return String(filename || '').replace(/\.[^.]+$/, '');
}

function sanitizeDriveFilename_(name) {
  return String(name || '')
    .replace(/[\/\\]/g, '-')
    .replace(/\s+/g, ' ')
    .trim();
}

function nowString_() {
  return Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    'yyyy-MM-dd HH:mm:ss'
  );
}

/************************************************************
 * ENCODING FIX v2
 *
 * Покрываемые случаи порчи имён:
 *  A) CP866-байты прочитаны как MacCyrillic
 *  B) CP866-байты прочитаны как CP1252
 *  C) случай B, дополнительно испорченный старым фиксом A
 ************************************************************/

function normalizeMangoFilename_(filename) {
  const original = String(filename || '').normalize('NFC');

  if (!hasSuspiciousEncodingChars_(original)) {
    return sanitizeDriveFilename_(original);
  }

  const candidates = [
    decodeMacCyrillicAsCp866_(original),                        // случай A
    decodeCp1252AsCp866_(original),                             // случай B
    decodeCp1252AsCp866_(undoMacCyrillicFix_(original))         // случай C
  ];

  let best = original;
  let bestScore = filenameHumanScore_(original);

  for (const candidate of candidates) {
    if (!candidate || candidate === original) continue;
    const score = filenameHumanScore_(candidate);
    if (score > bestScore) {
      best = candidate;
      bestScore = score;
    }
  }

  return sanitizeDriveFilename_(best);
}

function hasSuspiciousEncodingChars_(text) {
  // Box-drawing/блоки (╘╩╟╔ и т.п.), CP1252-артефакты (Š ¤ ¦ ¥ ¢ ª и др.),
  // MacCyrillic-артефакты («»®™ и др.), латиница с диакритикой.
  return /[\u0300-\u036F\u2500-\u25FF†‡¶®©™ЂЃ§ҐґЈјЅѕЉљЊњЋћЌќЇїІіЄєµ≤≥≈∆∞±√ƒ«»…€‚„‰Š‹ŒŽšžŸ¤¦¥¢ª¨¬°·¿Ààáâãäåæçèéêëìíîïðñòóôõöùúûüýþÿ]/.test(String(text || ''));
}

function filenameHumanScore_(text) {
  const s = String(text || '');

  const russianLetters = (s.match(/[А-Яа-яЁё]/g) || []).length;
  const digits = (s.match(/\d/g) || []).length;
  const suspicious = (s.match(/[\u0300-\u036F\u2500-\u25FF†‡¶®©™ЂЃ§ҐґЈјЅѕЉљЊњЋћЌќЇїІіЄєµ≤≥≈∆∞±√ƒ«»…€‚„‰Š‹ŒŽšžŸ¤¦¥¢ª¨¬¿Ààáâãäåæçèéêëìíîïðñòóôõöùúûüýþÿ]/g) || []).length;
  const replacement = (s.match(/�/g) || []).length;

  return russianLetters * 3 + digits - suspicious * 8 - replacement * 20;
}

/**
 * Случай A: CP866-байты были прочитаны как MacCyrillic.
 */
function decodeMacCyrillicAsCp866_(text) {
  const source = String(text || '').normalize('NFC');

  const macChars = getMacCyrillicChars128_();
  const cp866Chars = getCp866Chars128_();

  const macCharToByte = {};

  for (let i = 0; i < macChars.length; i++) {
    macCharToByte[macChars[i]] = 128 + i;
  }

  let result = '';

  for (let i = 0; i < source.length; i++) {
    const ch = source[i];
    const code = ch.charCodeAt(0);

    if (code <= 127) {
      result += ch;
      continue;
    }

    const byteValue = macCharToByte[ch];

    if (byteValue === undefined) {
      result += ch;
      continue;
    }

    result += cp866Chars[byteValue - 128] || ch;
  }

  return result;
}

/**
 * Случай B: имя в CP866 было прочитано как CP1252.
 * Символ → байт по таблице CP1252, байт → символ CP866.
 */
function decodeCp1252AsCp866_(text) {
  const source = String(text || '').normalize('NFC');

  const cp1252Chars = getCp1252Chars128_();
  const cp866Chars = getCp866Chars128_();

  const cp1252CharToByte = {};

  for (let i = 0; i < cp1252Chars.length; i++) {
    if (cp1252Chars[i]) cp1252CharToByte[cp1252Chars[i]] = 128 + i;
  }
  // NBSP встречается и после нормализаций — → 0xA0 ('а' в CP866)
  cp1252CharToByte['\u00A0'] = 0xA0;

  let result = '';

  for (let i = 0; i < source.length; i++) {
    const ch = source[i];
    const code = ch.charCodeAt(0);

    if (code <= 127) {
      result += ch;
      continue;
    }

    // Байты без символа в CP1252 (0x81,0x8D,0x8F,0x90,0x9D) часто доезжают
    // как невидимые управляющие U+0080–U+009F — используем код как байт.
    if (code >= 0x80 && code <= 0x9F && cp1252CharToByte[ch] === undefined) {
      result += cp866Chars[code - 128] || ch;
      continue;
    }

    const byteValue = cp1252CharToByte[ch];

    if (byteValue === undefined) {
      result += ch;
      continue;
    }

    result += cp866Chars[byteValue - 128] || ch;
  }

  return result;
}

/**
 * Откат старого фикса (для случая C): символ CP866 → байт,
 * байт → символ MacCyrillic. Возвращает строку к виду,
 * который был ДО применения decodeMacCyrillicAsCp866_.
 */
function undoMacCyrillicFix_(text) {
  const source = String(text || '').normalize('NFC');

  const cp866Chars = getCp866Chars128_();
  const macChars = getMacCyrillicChars128_();

  const cp866CharToByte = {};

  for (let i = 0; i < cp866Chars.length; i++) {
    if (cp866CharToByte[cp866Chars[i]] === undefined) {
      cp866CharToByte[cp866Chars[i]] = 128 + i;
    }
  }

  let result = '';

  for (let i = 0; i < source.length; i++) {
    const ch = source[i];
    const code = ch.charCodeAt(0);

    if (code <= 127) {
      result += ch;
      continue;
    }

    const byteValue = cp866CharToByte[ch];

    if (byteValue === undefined) {
      result += ch;
      continue;
    }

    const macChar = macChars[byteValue - 128] || '';

    // Откатываем только артефакты: если MacCyr-прообраз — кириллица,
    // символ двусмысленен (например «¤»/«е») и его трогать нельзя.
    if (/[А-Яа-яЁё]/.test(macChar)) {
      result += ch;
      continue;
    }

    result += macChar || ch;
  }

  return result;
}

