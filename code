/************************************************************
 * SCAN GOOGLE DRIVE (С ЛОГОМ НА ЛИСТ «Лог»)
 ************************************************************/

function scanMangoRecordingsFolder() {
  const runId = 'run-' + Date.now();
  const log = [];

  const push = function(step, file, details) {
    log.push([
      nowString_(),
      runId,
      String(step || ''),
      String(file || '').slice(0, 300),
      String(details || '').slice(0, 2000)
    ]);
  };

  try {
    push('START', '', 'Запуск сканирования');

    const sheet = getOrCreateSheet_();
    ensureHeaders_(sheet);

    const headerMap = getHeaderMap_(sheet);
    const existingCallKeys = loadExistingCallKeys_(sheet, headerMap);

    // Справочник сотрудников читается один раз за ран: матчинг ФИО
    // оператора идёт по листу «Сотрудники», без обращений в Битрикс.
    const employees = loadEmployeesFromSheet_(push);

    // Ручной маппинг «Операторы»: он авторитетнее автоматического матчинга.
    const operatorMapping = loadOperatorMapping_(push);

    push('EMPLOYEES', '', 'Справочник сотрудников: ' + employees.length + ' записей');

    const rootFolder = DriveApp.getFolderById(CONFIG.SOURCE_FOLDER_ID);
    push('FOLDER', '', 'ID: ' + CONFIG.SOURCE_FOLDER_ID + ', название: ' + rootFolder.getName());

    // Рекурсивный обход: корневая папка + все вложенные.
    const folderQueue = [rootFolder];

    let processed = 0;
    let added = 0;
    let skippedDuplicates = 0;
    let renamed = 0;
    let skippedNotMp3 = 0;
    let errors = 0;

    const rowsToAppend = [];

    while (folderQueue.length > 0 && processed < CONFIG.MAX_FILES_PER_RUN) {
      const currentFolder = folderQueue.shift();

      const subFolders = currentFolder.getFolders();
      while (subFolders.hasNext()) {
        const sub = subFolders.next();
        folderQueue.push(sub);
        push('SUBFOLDER', '', 'Найдена подпапка: ' + sub.getName());
      }

      const files = currentFolder.getFiles();

      while (files.hasNext() && processed < CONFIG.MAX_FILES_PER_RUN) {
        const file = files.next();
        processed++;

        try {
          const filenameRaw = file.getName();

          push(
            'FILE',
            filenameRaw,
            'MIME: ' + file.getMimeType() + ', размер: ' + file.getSize() + ' байт'
          );

          if (!isMp3_(filenameRaw)) {
            skippedNotMp3++;
            push('SKIP', filenameRaw, 'Пропуск: файл не MP3');
            continue;
          }

          const filenameFixed = normalizeMangoFilename_(filenameRaw);

          if (filenameFixed !== filenameRaw) {
            push('FIXED_NAME', filenameRaw, 'Исправленное имя: ' + filenameFixed);
          }

          // Сначала разбор — ключ строится из разобранных данных
          // (дата__время__телефон), независимых от кодировки имени.
          const parsed = parseMangoFilename_(filenameFixed);

          push(
            'PARSED',
            filenameFixed,
            parsed.error_text
              ? 'ОШИБКА РАЗБОРА: ' + parsed.error_text
              : 'direction: ' + parsed.direction +
                ', client_phone: ' + parsed.client_phone +
                ', operator: ' + parsed.operator_name +
                ', datetime: ' + parsed.call_datetime
          );

          const callKey = buildCallKey_(parsed, filenameFixed);
          const legacyKey = buildLegacyCallKey_(filenameFixed);

          push('CALL_KEY', filenameFixed, callKey || '(пустой)');

          if (!callKey) {
            errors++;
            push('SKIP', filenameFixed, 'Пропуск: не удалось сформировать call_key');
            continue;
          }

          // Дубль — если совпал новый ключ ИЛИ старый ключ-имя
          // (строки, добавленные до перехода на новый формат ключа).
          if (existingCallKeys.has(callKey) || (legacyKey && existingCallKeys.has(legacyKey))) {
            skippedDuplicates++;
            push('DUPLICATE', filenameFixed, 'Дубль по call_key: ' + callKey);

            if (CONFIG.RENAME_FILES_ON_DRIVE && filenameFixed !== filenameRaw) {
              file.setName(filenameFixed);
              renamed++;
              push('RENAMED', filenameRaw, '→ ' + filenameFixed);
            }

            continue;
          }

          if (CONFIG.RENAME_FILES_ON_DRIVE && filenameFixed !== filenameRaw) {
            file.setName(filenameFixed);
            renamed++;
            push('RENAMED', filenameRaw, '→ ' + filenameFixed);
          }

          const now = nowString_();

          // Матчинг оператора. Сначала ручной маппинг листа «Операторы»
          // (он авторитетен), иначе — то, что извлеклось из имени файла.
          // Подстановка полного ФИО из справочника разрешена только при
          // надёжном совпадении; иначе в operator_name остаётся исходное
          // значение, а причина видна в «Логе».
          const mapped = operatorMapping[normalizeFio_(parsed.mango_side)] || '';
          const operatorInput = mapped || parsed.operator_name;

          const operatorMatch = matchEmployeeByName_(operatorInput, employees);
          const operatorMatched = isConfidentEmployeeMatch_(operatorMatch.status);

          push(
            'EMPLOYEE_MATCH_OPERATOR',
            filenameFixed,
            'raw="' + operatorInput + '", status=' + operatorMatch.status +
              ', bitrix="' + operatorMatch.full_name + '", id=' + operatorMatch.bitrix_user_id +
              (operatorMatch.comment ? ', comment=' + operatorMatch.comment : '') +
              (mapped
                ? ', ручное сопоставление (лист «' + CONFIG.OPERATORS_SHEET_NAME + '»): ' +
                  parsed.mango_side + ' → ' + mapped
                : '')
          );

          const rowObj = {
            call_key: callKey,
            filename_raw: filenameRaw,
            filename_fixed: filenameFixed,

            call_datetime: parsed.call_datetime,
            call_date: parsed.call_date,
            call_time: parsed.call_time,

            direction: parsed.direction,
            client_phone: parsed.client_phone,
            mango_side: parsed.mango_side,
            line_name: parsed.line_name,
            operator_name: operatorMatched ? operatorMatch.full_name : operatorInput,

            drive_file_id: file.getId(),
            drive_url: file.getUrl(),

            status: parsed.error_text ? 'ERROR' : 'NEW',
            error_text: parsed.error_text,
            created_at: now,
            updated_at: now
          };

          rowsToAppend.push(makeRowByHeaders_(rowObj, headerMap, sheet.getLastColumn()));
          existingCallKeys.add(callKey);
          if (legacyKey) existingCallKeys.add(legacyKey);
          added++;

          push('ROW_PREPARED', filenameFixed, 'Строка подготовлена, call_key: ' + callKey);

        } catch (e) {
          errors++;
          push('ERROR', '', String((e && e.stack) || e));
        }
      }
    }

    if (rowsToAppend.length > 0) {
      push('WRITE_START', '', 'Запись строк в таблицу: ' + rowsToAppend.length);

      sheet
        .getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, rowsToAppend[0].length)
        .setValues(rowsToAppend);

      push('WRITE_END', '', 'Запись завершена');
    } else {
      push('WRITE_SKIP', '', 'Новых строк нет');
    }

    const message =
      'Готово. Обработано: ' + processed +
      ', добавлено: ' + added +
      ', дублей: ' + skippedDuplicates +
      ', переименовано: ' + renamed +
      ', не mp3: ' + skippedNotMp3 +
      ', ошибок: ' + errors;

    push('FINISH', '', message);
    SpreadsheetApp.getActive().toast(message);

  } catch (e) {
    push('FATAL', '', String((e && e.stack) || e));
    throw e;
  } finally {
    flushLog_(log);
  }
}

